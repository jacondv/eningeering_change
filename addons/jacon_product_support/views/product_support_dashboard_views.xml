<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A list-typed view only so the dashboard gets the standard control
         panel and search bar for free; its js_class swaps in the dashboard
         controller, which never loads the records themselves. -->
    <record id="view_product_support_request_dashboard" model="ir.ui.view">
        <field name="name">product.support.request.dashboard</field>
        <field name="model">product.support.request</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list js_class="product_support_dashboard">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_product_support_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">product.support.request</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_support_request_dashboard"/>
        <field name="search_view_id" ref="view_product_support_request_search"/>
    </record>

</odoo>
