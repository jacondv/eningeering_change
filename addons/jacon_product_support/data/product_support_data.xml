<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Counter restarts monthly: one date range per month, created on first
         use by ProductSupportRequest._next_request_no(). -->
    <record id="seq_product_support_request" model="ir.sequence">
        <field name="name">Product Support Request</field>
        <field name="code">product.support.request</field>
        <field name="prefix">%(range_y)s%(range_month)sPS</field>
        <field name="padding">2</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>

    <record id="fault_category_hydraulic" model="product.support.fault.category">
        <field name="name">Hydraulic</field>
        <field name="sequence">10</field>
    </record>
    <record id="fault_category_electrical" model="product.support.fault.category">
        <field name="name">Electrical</field>
        <field name="sequence">20</field>
    </record>
    <record id="fault_category_engine" model="product.support.fault.category">
        <field name="name">Engine</field>
        <field name="sequence">30</field>
    </record>
    <record id="fault_category_structure" model="product.support.fault.category">
        <field name="name">Structure</field>
        <field name="sequence">40</field>
    </record>
    <record id="fault_category_control" model="product.support.fault.category">
        <field name="name">Control / Software</field>
        <field name="sequence">50</field>
    </record>
    <record id="fault_category_other" model="product.support.fault.category">
        <field name="name">Other</field>
        <field name="sequence">90</field>
    </record>

</odoo>
