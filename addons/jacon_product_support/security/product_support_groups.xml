<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_product_support" model="ir.module.category">
        <field name="name">Jacon - Product Support</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_ps_user" model="res.groups.privilege">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_product_support"/>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_ps_manager" model="res.groups.privilege">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_product_support"/>
        <field name="sequence">20</field>
    </record>

    <!-- Actions are project.task records, so users need Project User rights. -->
    <record id="group_ps_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_ps_user"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="comment">Can create, edit and archive Support Requests.</field>
    </record>

    <record id="group_ps_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_ps_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_ps_user'))]"/>
        <field name="comment">Can also delete Support Requests and configure Fault Categories.</field>
    </record>

</odoo>
