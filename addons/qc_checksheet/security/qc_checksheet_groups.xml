<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_qc_checksheet" model="ir.module.category">
            <field name="name">Jacon - QC Check Sheet</field>
            <field name="sequence">33</field>
        </record>

        <!-- Each capability sits on its own privilege (1 group per privilege), so
             they render as independent checkboxes in Settings > Users > Access Rights.
             View is implied by Internal User, so it can't be unticked per user. Create
             & Edit is deliberately NOT implied by it: hooks.py hands it out as a default
             instead, which is what lets an admin untick it for a single user. -->
        <record id="privilege_qc_checksheet_user" model="res.groups.privilege">
            <field name="name">View</field>
            <field name="category_id" ref="module_category_qc_checksheet"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_qc_checksheet_author" model="res.groups.privilege">
            <field name="name">Create &amp; Edit</field>
            <field name="category_id" ref="module_category_qc_checksheet"/>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_qc_checksheet_approver" model="res.groups.privilege">
            <field name="name">Approve</field>
            <field name="category_id" ref="module_category_qc_checksheet"/>
            <field name="sequence">30</field>
        </record>

        <record id="privilege_qc_checksheet_admin" model="res.groups.privilege">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_qc_checksheet"/>
            <field name="sequence">40</field>
        </record>

        <record id="group_qc_user" model="res.groups">
            <field name="name">View</field>
            <field name="privilege_id" ref="privilege_qc_checksheet_user"/>
            <field name="comment">Can view and print QC Check Sheets.</field>
        </record>

        <record id="group_qc_author" model="res.groups">
            <field name="name">Create &amp; Edit</field>
            <field name="privilege_id" ref="privilege_qc_checksheet_author"/>
            <field name="implied_ids" eval="[(4, ref('group_qc_user'))]"/>
            <field name="comment">Can create and edit Draft check sheets, submit or recall them, and start a New Revision.</field>
        </record>

        <record id="group_qc_approver" model="res.groups">
            <field name="name">Approve</field>
            <field name="privilege_id" ref="privilege_qc_checksheet_approver"/>
            <field name="implied_ids" eval="[(4, ref('group_qc_user'))]"/>
            <field name="comment">Can approve or reject submitted check sheets.</field>
        </record>

        <record id="group_qc_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_qc_checksheet_admin"/>
            <field name="implied_ids" eval="[(4, ref('group_qc_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Can manage Check Sheet Types and delete a whole issued sheet. Does not include Approve.</field>
        </record>

    </data>
</odoo>
