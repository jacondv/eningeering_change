<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="qc_checksheet.Dashboard">
        <div class="o_action o_qce_action">
            <div class="o_qce">
                <div class="o_qce_topbar">
                    <strong class="o_qce_title">QC Dashboard</strong>
                    <span class="flex-grow-1"/>
                    <button t-if="data.can_author" class="btn btn-primary" t-on-click="newSheet">New Check Sheet</button>
                </div>
                <div class="o_qcd">
                    <div class="o_qcd_tiles">
                        <t t-foreach="kpiTiles" t-as="tile" t-key="tile.key">
                            <button class="o_qcd_tile" t-att-class="{'o_qcd_tile_on': state.filters.kpi === tile.key}"
                                    t-att-aria-pressed="state.filters.kpi === tile.key ? 'true' : 'false'"
                                    t-att-title="state.filters.kpi === tile.key ? 'Click again to show every Job' : 'Show only these Jobs'"
                                    t-on-click="() => this.toggleKpi(tile.key)">
                                <span class="o_qcd_tile_value" t-esc="data.kpis[tile.key]"/>
                                <span class="o_qcd_tile_label" t-esc="tile.label"/>
                            </button>
                        </t>
                    </div>

                    <div class="o_qcd_filters">
                        <span class="fw-bold">Job status</span>
                        <t t-foreach="jobStatuses" t-as="status" t-key="status.key">
                            <button class="o_qcd_chip" t-att-class="{'o_qcd_chip_on': state.filters.statuses.includes(status.key)}"
                                    t-att-aria-pressed="state.filters.statuses.includes(status.key) ? 'true' : 'false'"
                                    t-on-click="() => this.toggleStatus(status.key)" t-esc="status.label"/>
                        </t>
                        <input class="form-control o_qcd_search" placeholder="Search Job, Model or Customer" aria-label="Search Job, Model or Customer"
                               t-att-value="state.filters.search" t-on-input="onSearchInput"/>
                        <select class="form-select o_qcd_model" aria-label="Model" t-on-change="onModelChange">
                            <option value="">All Models</option>
                            <t t-foreach="data.models" t-as="model" t-key="model.id">
                                <option t-att-value="model.id" t-att-selected="model.id === state.filters.model_id" t-esc="model.name"/>
                            </t>
                        </select>
                        <span class="flex-grow-1"/>
                        <span class="text-muted small">★ Required for every Job · waiting <t t-esc="data.overdue_days"/>+ days is flagged</span>
                    </div>

                    <div class="o_qce_panel o_qcd_table_box">
                        <table class="o_qcd_table">
                            <thead>
                                <tr>
                                    <th class="o_qcd_job_col">
                                        <button class="o_qcd_sort" t-on-click="() => this.sortBy('job')">
                                            Job <i t-if="state.filters.sort === 'job'" class="fa fa-sort-desc" aria-hidden="true"/>
                                        </button>
                                    </th>
                                    <th>Model</th>
                                    <th>
                                        <button class="o_qcd_sort" title="Required Types with a Released sheet" t-on-click="() => this.sortBy('done')">
                                            Done <i t-if="state.filters.sort === 'done'" class="fa fa-sort-asc" aria-hidden="true"/>
                                        </button>
                                    </th>
                                    <t t-foreach="data.columns" t-as="column" t-key="column.id">
                                        <th class="o_qcd_type_col" t-att-title="column.name">
                                            <span t-if="column.required" class="o_qce_required">★</span><t t-esc="column.code"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data.rows" t-as="row" t-key="row.id">
                                    <td class="o_qcd_job_col">
                                        <button class="btn btn-link p-0 fw-bold" t-on-click="() => this.openJob(row)" t-esc="row.name"/>
                                        <div class="small text-muted" t-esc="row.customer or 'No customer'"/>
                                    </td>
                                    <td t-esc="row.model"/>
                                    <td class="text-nowrap" t-att-class="{'o_qcd_done_full': row.released === data.required}">
                                        <t t-esc="row.released"/>/<t t-esc="data.required"/>
                                    </td>
                                    <t t-foreach="data.columns" t-as="column" t-key="column.id">
                                        <t t-set="cell" t-value="row.cells[column.id]"/>
                                        <td class="o_qcd_cell_td">
                                            <button t-if="cell.id or (cell.state === 'missing' and data.can_author)" t-att-class="cellClass(cell)"
                                                    t-att-title="cellTitle(cell)" t-on-click="() => this.onCellClick(row, column)">
                                                <t t-if="cell.id">
                                                    <span class="o_qcd_cell_main"><t t-esc="stateLabel(cell.state)"/> R<t t-esc="cell.revision"/></span>
                                                    <span t-if="cell.next" class="o_qcd_cell_sub">
                                                        R<t t-esc="cell.next.revision"/> <t t-esc="cell.next.state === 'review' ? 'in review' : 'in progress'"/>
                                                    </span>
                                                    <span t-if="cell.waiting_days and isOverdue(cell)" class="o_qcd_cell_sub o_qcd_overdue">
                                                        Waiting <t t-esc="cell.waiting_days"/> days
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span class="o_qcd_cell_main">+ Create</span>
                                                    <span class="o_qcd_cell_sub">Missing</span>
                                                </t>
                                            </button>
                                            <span t-elif="cell.state === 'missing'" class="o_qcd_cell o_qcd_cell_missing" title="Required for every Job, not created yet">Missing</span>
                                            <span t-else="" class="text-muted" aria-label="Not used">–</span>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="!data.rows.length" class="p-3 text-muted">No Job matches these filters.</div>
                    </div>

                    <div class="o_qcd_pager">
                        <span class="text-muted" t-esc="pagerLabel"/>
                        <button class="btn btn-secondary btn-sm" aria-label="Previous page" t-att-disabled="data.offset === 0" t-on-click="() => this.page(-1)"><i class="fa fa-chevron-left"/></button>
                        <button class="btn btn-secondary btn-sm" aria-label="Next page" t-att-disabled="data.offset + data.page_size >= data.total" t-on-click="() => this.page(1)"><i class="fa fa-chevron-right"/></button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
