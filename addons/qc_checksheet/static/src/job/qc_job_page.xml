<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="qc_checksheet.JobPage">
        <div class="o_action o_qce_action o_qce_with_chatter" t-ref="page">
            <div class="o_qce">
            <div class="o_qce_topbar">
                <span class="o_qce_kind" title="The check sheets of one Job: printed, scanned, and moved to a newer Revision from here">Job QC</span>
                <button class="btn btn-link p-0 o_qce_title" t-on-click="openJobForm" t-esc="job.name"/>
                <span class="text-muted">
                    <button t-if="job.model_id" class="btn btn-link p-0 align-baseline" title="Open this Model's check sheets"
                            t-on-click="openModel" t-esc="job.model"/>
                    <t t-else="">No Model</t>
                    · <t t-esc="job.customer or 'No customer'"/> · Serial <t t-esc="job.serial or '-'"/>
                </span>
                <span class="flex-grow-1"/>
                <strong title="Required Types this Job can print"><t t-esc="job.ready"/>/<t t-esc="job.required"/> required ready</strong>
                <strong class="ms-3" title="Required Types with a signed scan on the Revision the Job prints"><t t-esc="job.scanned"/>/<t t-esc="job.required"/> required scanned</strong>
                <button t-if="printableRows.length" class="btn btn-secondary" t-on-click="printAll">Print All</button>
            </div>
            <div class="o_qce_notice">
                The check sheets of this Job: print them, upload their signed scans, and ask for a newer Revision. The sheets themselves are written
                and revised on the Model's page<t t-if="job.model_id"> (<a href="#" t-on-click.prevent="openModel" t-esc="job.model"/>)</t>.
            </div>
            <div t-if="!job.model_id" class="o_qce_notice o_qce_notice_danger">
                This Job has no Model. Set its Model to print the Model's check sheets.
            </div>
            <div t-if="job.changes.length" class="o_qce_notice o_qce_notice_warning">
                <strong>Engineering Changes in progress for this Job:</strong>
                <t t-foreach="job.changes" t-as="change" t-key="change.id">
                    <a href="#" class="ms-2" t-on-click.prevent="() => this.openChange(change)" t-esc="change.name"/>
                    <span class="text-muted"><t t-esc="change.title"/> (<t t-esc="change.state_label"/>)</span>
                </t>
            </div>
            <div t-if="state.selected.length" class="o_qce_selection">
                <strong><t t-esc="state.selected.length"/> selected</strong>
                <button class="btn btn-secondary btn-sm o_qce_danger" title="Take these sheets away from the Job; a sheet with a signed scan stays" t-on-click="deleteSelected">Delete</button>
                <button class="btn btn-link btn-sm" t-on-click="clearSelection">Clear</button>
            </div>
            <div class="o_qce_job">
                <div class="o_qce_panel o_qce_scroll_x">
                    <table class="o_qce_table" t-ref="resizable">
                        <thead>
                            <tr><th class="o_qce_select_col"><input t-if="selectableRows.length" type="checkbox" aria-label="Select all" t-att-checked="allSelected" t-on-change="toggleAll"/></th><th>Type</th><th>Job Number</th><th>Number</th><th>Header</th><th>Rev</th><th>Status</th><th/></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="job.rows" t-as="row" t-key="row.type_id" t-att-data-type-id="row.type_id"
                                t-att-class="{'o_qce_job_missing': row.required and !printed(row), 'o_qce_row_focus': state.focused === row.type_id}">
                                <t t-set="sheet" t-value="printed(row)"/>
                                <td class="o_qce_select_col">
                                    <input t-if="row.pinned and job.can_delete_sheets" type="checkbox" t-att-aria-label="'Select ' + row.type_name"
                                           t-att-checked="state.selected.includes(row.type_id)" t-on-change="() => this.toggle(row)"/>
                                </td>
                                <td>
                                    <span t-if="row.required" class="o_qce_required" title="Required for every Job">★</span>
                                    <t t-esc="row.type_name"/>
                                    <div t-if="row.shared_from" class="small text-muted" title="The Model of this Job uses the sheet of another Model">Sheet of <t t-esc="row.shared_from"/></div>
                                </td>
                                <td t-esc="job.name"/>
                                <td t-esc="sheet ? sheet.number : '-'"/>
                                <td t-esc="sheet ? sheet.header : '-'"/>
                                <td>
                                    <t t-esc="sheet ? sheet.revision : '-'"/>
                                </td>
                                <td>
                                    <t t-if="row.pinned">
                                        <span class="o_qce_badge o_qce_badge_released">Printed</span>
                                        <div class="small text-muted mt-1">
                                            Rev <t t-esc="row.pinned.revision"/> since <t t-esc="formatDateTime(row.pinned.pinned_date)"/>
                                            <t t-if="row.pinned.pinned_by"> by <t t-esc="row.pinned.pinned_by"/></t>
                                        </div>
                                        <div t-if="row.outdated and row.current" class="small text-warning mt-1">
                                            Rev <t t-esc="row.current.revision"/> is now current on the Model
                                        </div>
                                        <div t-if="row.pinned.other_model" class="small text-warning mt-1">From another Model: the Job's Model changed</div>
                                        <div t-if="row.pending" class="o_qce_notice o_qce_notice_warning mt-2 mb-0">
                                            <strong>Change to Rev <t t-esc="row.pending.revision"/> waiting for approval</strong>
                                            <div class="small">Asked by <t t-esc="row.pending.requested_by"/>
                                                on <t t-esc="formatDateTime(row.pending.requested_date)"/>: <t t-esc="row.pending.reason"/></div>
                                            <div class="mt-1 d-flex gap-2">
                                                <button t-if="row.pending.can_decide" class="btn btn-primary btn-sm" t-on-click="() => this.approve(row)">Approve</button>
                                                <button t-if="row.pending.can_decide" class="btn btn-secondary btn-sm" t-on-click="() => this.reject(row)">Reject</button>
                                                <button t-if="row.pending.can_cancel" class="btn btn-link btn-sm" t-on-click="() => this.cancelRequest(row)">Cancel request</button>
                                            </div>
                                        </div>
                                        <div t-if="row.inspection" class="o_qce_inspection mt-2">
                                            <span t-attf-class="o_qce_badge o_qce_badge_insp_{{row.inspection.state}}" t-esc="row.inspection.state_label"/>
                                            <span t-if="row.inspection.waived" class="small text-muted ms-1">re-inspection skipped</span>
                                            <t t-set="scans" t-value="row.inspection.scans"/>
                                            <div t-if="scans.length" class="mt-1">
                                                <t t-call="qc_checksheet.ScanLine"><t t-set="scan" t-value="scans[0]"/></t>
                                                <t t-if="scans.length > 1">
                                                    <button class="btn btn-link btn-sm p-0" t-on-click="() => this.toggleScans(row)">
                                                        <t t-esc="state.openScans[row.type_id] ? 'Hide' : 'Show'"/> <t t-esc="scans.length - 1"/> earlier scan(s)
                                                    </button>
                                                    <t t-if="state.openScans[row.type_id]">
                                                        <t t-foreach="scans.slice(1)" t-as="scan" t-key="scan.id">
                                                            <t t-call="qc_checksheet.ScanLine"/>
                                                        </t>
                                                    </t>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-elif="row.current">
                                        <span class="o_qce_badge o_qce_badge_draft">Not printed yet</span>
                                        <div class="small text-muted mt-1">The first print keeps Rev <t t-esc="row.current.revision"/> for this Job</div>
                                    </t>
                                    <t t-else="">
                                        <span class="o_qce_badge o_qce_badge_missing">Waiting for the Model</span>
                                        <div t-if="row.next" class="small text-muted mt-1">
                                            Rev <t t-esc="row.next.revision"/> <t t-esc="row.next.state_label"/> on the Model
                                        </div>
                                    </t>
                                </td>
                                <td class="text-end">
                                    <div t-if="sheet" class="o_qce_actions">
                                        <!-- Not named "action": the loop variable would replace the component's action service. -->
                                        <button t-foreach="actions(row)" t-as="item" t-key="item.key" class="btn btn-sm"
                                                t-att-class="item.css" t-att-title="item.title" t-att-disabled="item.disabled"
                                                t-on-click="item.run" t-esc="item.label"/>
                                    </div>
                                    <button t-elif="job.model_id and (job.can_share or job.can_author)" class="btn btn-secondary btn-sm"
                                            title="The Model has no sheet of this Type yet: use another Model's, or create one" t-on-click="() => this.createSheet(row)">Create</button>
                                    <button t-elif="job.model_id" class="btn btn-link btn-sm" t-on-click="openModel">Go to the Model</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div t-if="!job.rows.length" class="p-3 text-muted">No Check Sheet Type is required yet. Mark Types as Required in Configuration.</div>
                </div>
            </div>
        </div>
        <QcChatterPanel threadModel="'project.project'" threadId="jobId"/>
        </div>
    </t>

    <!-- One scan: the Revision checked, the day, who uploaded, and its files to open. -->
    <t t-name="qc_checksheet.ScanLine">
        <div class="small o_qce_scan_line">
            <i class="fa fa-paperclip text-muted"/>
            <span t-attf-class="{{scan.covers_current ? '' : 'text-muted'}}">Rev <t t-esc="scan.revision"/> · checked <t t-esc="formatDay(scan.check_date)"/></span>
            <span class="text-muted">· <t t-esc="scan.uploaded_by"/> · <t t-esc="scan.total_size"/></span>
            <t t-foreach="scan.files" t-as="file" t-key="file.id">
                <a t-att-href="file.url" target="_blank" rel="noopener" t-att-title="file.size" t-esc="file.name"/>
            </t>
            <span t-if="scan.note" class="text-muted fst-italic" t-esc="scan.note"/>
            <button t-if="row.inspection.can_delete" class="o_qce_icon" title="Delete this scan (QC Administrator)"
                    t-on-click="() => this.deleteScan(scan)"><i class="fa fa-trash-o"/></button>
        </div>
    </t>

    <t t-name="qc_checksheet.UpdateRevisionDialog">
        <Dialog title="isChoosing ? 'Choose the Revision of ' + props.typeName : 'Change the Revision of ' + props.typeName" size="'lg'">
            <div t-if="props.scanWarning" class="o_qce_notice o_qce_notice_warning mb-3" t-esc="props.scanWarning"/>
            <p class="text-muted" t-if="isChoosing">The Job is pinned to the Revision you pick right away, and keeps it. No approval is needed for this first pinning.</p>
            <p class="text-muted" t-else="">An Approver has to approve this. The Job keeps the Revision it prints now until then.</p>
            <div class="o_qce_scroll_x">
                <table class="o_qce_table">
                    <thead><tr><th/><th>Rev</th><th>Status</th><th>Reason for change</th><th>Engineering Changes</th></tr></thead>
                    <tbody>
                        <tr t-foreach="props.options" t-as="option" t-key="option.id" t-att-class="{'o_qcd_clickable': !option.pinned}"
                            t-on-click="() => this.pick(option)">
                            <td><input type="radio" name="qc_update_rev" t-att-checked="state.revisionId === option.id"
                                       t-att-disabled="option.pinned" t-att-aria-label="'Rev ' + option.revision"/></td>
                            <td class="fw-bold" t-esc="option.revision"/>
                            <td>
                                <span t-attf-class="o_qce_badge o_qce_badge_{{option.state}}" t-esc="option.state_label"/>
                                <span t-if="option.current" class="small text-muted ms-1">current on the Model</span>
                                <span t-if="option.pinned" class="small text-warning ms-1">this Job prints it now</span>
                            </td>
                            <td t-esc="option.reason or '-'"/>
                            <td t-esc="option.changes or '-'"/>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div t-if="isOlder" class="o_qce_notice o_qce_notice_warning mt-3 mb-0">
                You are picking an older Revision. Check it is the one this machine was built to.
            </div>
            <div class="mt-3">
                <label class="fw-bold mb-1" for="qce_update_reason">Reason</label>
                <input id="qce_update_reason" class="form-control" autocomplete="off" t-model="state.reason"/>
                <small t-if="!isChoosing" class="text-muted">Copies of the old Revision already printed must be replaced.</small>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="isBlocked" t-on-click="confirm">
                    <t t-if="isChoosing">Pin Revision</t><t t-else="">Request Change</t>
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="qc_checksheet.PrintAllDialog">
        <Dialog title="'Print All: ' + props.jobName" size="'lg'">
            <div class="o_qce_scroll_x">
                <table class="o_qce_table">
                    <thead><tr><th/><th>Type</th><th>Number</th><th>Rev</th><th/></tr></thead>
                    <tbody>
                        <tr t-foreach="state.rows" t-as="row" t-key="row.type_id">
                            <td><input type="checkbox" t-att-aria-label="'Print ' + row.type_name" t-model="row.selected"/></td>
                            <td class="fw-bold text-nowrap" t-esc="row.type_name"/>
                            <td t-esc="row.sheet.number"/>
                            <td t-esc="row.sheet.revision"/>
                            <td class="small text-muted"><t t-if="!row.pinned">First print: keeps this Rev for the Job</t></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-column gap-1 mt-3">
                <label class="d-flex align-items-center gap-2">
                    <input type="radio" name="qc_print_all_mode" t-att-checked="!state.combined" t-on-change="() => { state.combined = false; }"/>
                    <span>One PDF per sheet <small class="text-muted">(downloaded together in a ZIP)</small></span>
                </label>
                <label class="d-flex align-items-center gap-2">
                    <input type="radio" name="qc_print_all_mode" t-att-checked="state.combined" t-on-change="() => { state.combined = true; }"/>
                    <span>One combined PDF</span>
                </label>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!selectedRows.length or state.printing" t-on-click="print">
                    Print <t t-esc="selectedRows.length"/> sheet(s)
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
