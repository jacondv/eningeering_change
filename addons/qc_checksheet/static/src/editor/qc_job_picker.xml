<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="qc_checksheet.JobPicker">
        <div class="o_qce_job_field">
            <div t-att-class="{'input-group input-group-sm': props.clearable}">
                <input t-att-id="props.inputId" class="form-control" autocomplete="off" t-att-placeholder="props.placeholder"
                       t-att-value="state.term" t-on-input="onInput" t-on-focus="onFocus" t-on-blur="onBlur"/>
                <button t-if="props.clearable and props.value" class="btn btn-secondary" title="Show all"
                        aria-label="Clear" t-on-click="() => this.pick(null)"><i class="fa fa-times"/></button>
            </div>
            <div t-if="state.open" class="o_qce_job_menu">
                <t t-foreach="state.results" t-as="job" t-key="job.id">
                    <button class="o_qce_job_option" t-on-mousedown.prevent="() => this.pick(job)">
                        <strong t-esc="job.name"/> <span class="text-muted" t-esc="job.model"/>
                    </button>
                </t>
                <div t-if="!state.results.length" class="text-muted p-2" t-esc="props.emptyText"/>
            </div>
        </div>
    </t>

</templates>
