<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="qc_checksheet.ModelPage">
        <div class="o_action o_qce_action">
            <div class="o_qce">
            <div class="o_qce_topbar">
                <button class="btn btn-link p-0 o_qce_title" t-on-click="openModelForm" t-esc="model.name"/>
                <span class="text-muted"><t t-esc="model.family or 'No Product Family'"/> · <t t-esc="model.job_count"/> Job(s)</span>
                <span class="flex-grow-1"/>
                <strong><t t-esc="model.released"/>/<t t-esc="model.required"/> required Released</strong>
                <button t-if="model.can_author and missingRows.length" class="btn btn-primary" t-on-click="() => this.create(missingRows)">
                    Create missing sheets (<t t-esc="missingRows.length"/>)
                </button>
            </div>
            <div class="o_qce_notice">
                Sheets are written and revised here. Each Job of this Model prints them from its own QC page, and keeps
                the Revision it first printed until it is updated.
            </div>
            <div t-if="model.changes.length" class="o_qce_notice o_qce_notice_warning">
                <strong>Engineering Changes in progress for this Model:</strong>
                <t t-foreach="model.changes" t-as="change" t-key="change.id">
                    <a href="#" class="ms-2" t-on-click.prevent="() => this.openChange(change)" t-esc="change.name"/>
                    <span class="text-muted"><t t-esc="change.title"/> (<t t-esc="change.state_label"/>)</span>
                </t>
            </div>
            <div class="o_qce_job">
                <div class="o_qce_panel o_qce_scroll_x">
                    <table class="o_qce_table">
                        <thead>
                            <tr><th>Type</th><th>Number</th><th>Header</th><th>Rev</th><th>Status</th><th>Jobs</th><th/></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="model.rows" t-as="row" t-key="row.type_id" t-att-class="{'o_qce_job_missing': row.required and !row.current}">
                                <td>
                                    <span t-if="row.required" class="o_qce_required" title="Required for every Job">★</span>
                                    <t t-esc="row.type_name"/>
                                </td>
                                <td t-esc="row.number or '-'"/>
                                <td t-esc="row.header or '-'"/>
                                <td t-esc="row.current ? row.current.revision : '-'"/>
                                <td>
                                    <t t-if="row.current">
                                        <span t-att-class="badgeClass(row.current)" t-esc="row.current.state_label"/>
                                        <div t-if="row.next" class="small text-muted mt-1">
                                            Rev <t t-esc="row.next.revision"/> <t t-esc="row.next.state_label"/>
                                        </div>
                                    </t>
                                    <span t-else="" class="o_qce_badge o_qce_badge_missing">Missing</span>
                                </td>
                                <td>
                                    <button t-if="row.jobs" class="btn btn-link p-0" title="Jobs pinned to this sheet, by Revision"
                                            t-on-click="() => this.openJobs(row)" t-esc="row.jobs"/>
                                    <span t-if="row.old_jobs" class="small text-warning ms-1" t-esc="'(' + row.old_jobs + ' on an old Rev)'"/>
                                    <span t-else="" class="text-muted">0</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <t t-if="row.current">
                                        <button class="btn btn-link" t-on-click="() => this.open(row.current)">Open</button>
                                        <button t-if="row.next" class="btn btn-link" t-on-click="() => this.open(row.next)">Open Rev <t t-esc="row.next.revision"/></button>
                                        <button class="btn btn-link" title="Blank, without any Job's details" t-on-click="() => this.print(row.current)">Print blank</button>
                                    </t>
                                    <button t-elif="model.can_author" class="btn btn-secondary btn-sm" t-on-click="() => this.create([row])">Create</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div t-if="!model.rows.length" class="p-3 text-muted">No Check Sheet Type is required yet. Mark Types as Required in Configuration.</div>
                </div>
            </div>
        </div>
        </div>
    </t>

    <t t-name="qc_checksheet.CreateSheetsDialog">
        <Dialog title="'Create check sheets for ' + props.modelName" size="'xl'">
            <p class="text-muted">Each one starts as Draft Rev 0. Copying brings over the content and approval positions only.</p>
            <div class="o_qce_scroll_x">
                <table class="o_qce_table o_qce_create_table">
                    <thead><tr><th/><th>Type</th><th>Start from</th><th>Header</th></tr></thead>
                    <tbody>
                        <tr t-foreach="state.rows" t-as="row" t-key="row.type_id">
                            <td><input type="checkbox" t-att-aria-label="'Create ' + row.type_name" t-model="row.selected"/></td>
                            <td class="fw-bold text-nowrap" t-esc="row.type_name"/>
                            <td>
                                <select class="form-select" t-att-aria-label="'Start ' + row.type_name + ' from'" t-att-disabled="!row.selected"
                                        t-on-change="(ev) => this.onSourceChange(row, ev)">
                                    <option value="" t-att-selected="!row.source_id">Blank sheet</option>
                                    <optgroup t-if="sameTypeOptions(row).length" t-att-label="'Released ' + row.type_name + ' of other Models'">
                                        <t t-foreach="sameTypeOptions(row)" t-as="option" t-key="option.id">
                                            <option t-att-value="option.id" t-att-selected="option.id === row.source_id" t-esc="option.label"/>
                                        </t>
                                    </optgroup>
                                    <optgroup t-if="otherTypeOptions(row).length" label="Other Types with the same layout">
                                        <t t-foreach="otherTypeOptions(row)" t-as="option" t-key="option.id">
                                            <option t-att-value="option.id" t-att-selected="option.id === row.source_id" t-esc="option.label"/>
                                        </t>
                                    </optgroup>
                                </select>
                            </td>
                            <td>
                                <input class="form-control" t-att-aria-label="'Header of ' + row.type_name" t-att-disabled="!row.selected"
                                       placeholder="Printed as the top line of the PDF" t-model="row.header"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="cannotCreate" t-on-click="create">
                    Create <t t-esc="selectedRows.length"/> sheet(s)
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
