<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_checksheet_reject_wizard_form" model="ir.ui.view">
        <field name="name">qc.checksheet.reject.wizard.form</field>
        <field name="model">qc.checksheet.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Check Sheet">
                <field name="checksheet_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="What needs to be corrected"/>
                </group>
                <footer>
                    <button string="Reject" name="action_reject" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qc_checksheet_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject</field>
        <field name="res_model">qc.checksheet.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
