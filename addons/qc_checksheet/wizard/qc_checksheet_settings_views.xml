<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_checksheet_settings_form" model="ir.ui.view">
        <field name="name">qc.checksheet.settings.form</field>
        <field name="model">qc.checksheet.settings</field>
        <field name="arch" type="xml">
            <form string="QC Check Sheet Settings">
                <group string="Dashboard">
                    <field name="review_overdue_days"/>
                </group>
                <group string="Scans">
                    <field name="scan_max_file_mb"/>
                </group>
                <footer>
                    <button string="Save" name="action_save" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qc_checksheet_settings" model="ir.actions.act_window">
        <field name="name">QC Check Sheet Settings</field>
        <field name="res_model">qc.checksheet.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
