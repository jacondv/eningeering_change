<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_job_change_approve_wizard_form" model="ir.ui.view">
        <field name="name">qc.job.change.approve.wizard.form</field>
        <field name="model">qc.job.change.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Revision Change">
                <field name="change_id" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    This Job already has a signed scan. <field name="scan_summary" class="d-inline"/>
                    Does the new Revision need a new inspection?
                </div>
                <group>
                    <field name="decision" widget="radio"/>
                    <field name="reason" invisible="decision != 'skipped'" required="decision == 'skipped'"
                           placeholder="e.g. the new Revision only corrects a typo"/>
                </group>
                <footer>
                    <button string="Approve" name="action_approve" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
