<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_checksheet_new_revision_wizard_form" model="ir.ui.view">
        <field name="name">qc.checksheet.new.revision.wizard.form</field>
        <field name="model">qc.checksheet.new.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="New Revision">
                <field name="checksheet_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="What is changing and why"/>
                </group>
                <footer>
                    <button string="Create Revision" name="action_create" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qc_checksheet_new_revision_wizard" model="ir.actions.act_window">
        <field name="name">New Revision</field>
        <field name="res_model">qc.checksheet.new.revision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
