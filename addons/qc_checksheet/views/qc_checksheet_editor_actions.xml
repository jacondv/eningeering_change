<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- With no active_id in its context this opens the New Check Sheet page,
         otherwise the editor of that sheet (see action_open_editor). -->
    <record id="action_qc_checksheet_editor" model="ir.actions.client">
        <field name="name">New Check Sheet</field>
        <field name="tag">qc_checksheet.editor</field>
        <field name="target">current</field>
    </record>

    <!-- Opened with the Job (project.project) as active_id, see
         ProjectProject.action_open_qc_job. -->
    <record id="action_qc_checksheet_job" model="ir.actions.client">
        <field name="name">Job QC Check Sheets</field>
        <field name="tag">qc_checksheet.job</field>
        <field name="target">current</field>
    </record>

    <record id="action_qc_checksheet_dashboard" model="ir.actions.client">
        <field name="name">QC Dashboard</field>
        <field name="tag">qc_checksheet.dashboard</field>
        <field name="target">current</field>
    </record>

</odoo>
