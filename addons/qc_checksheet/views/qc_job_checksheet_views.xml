<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_job_checksheet_list" model="ir.ui.view">
        <field name="name">qc.job.checksheet.list</field>
        <field name="model">qc.job.checksheet</field>
        <field name="arch" type="xml">
            <list string="Job Check Sheets" create="0" delete="0" decoration-warning="update_available">
                <field name="job_id"/>
                <field name="type_id"/>
                <field name="reference"/>
                <field name="revision"/>
                <field name="latest_revision"/>
                <field name="update_available" column_invisible="1"/>
                <field name="model_id"/>
                <field name="machine_serial" optional="show"/>
                <field name="job_status" optional="show"/>
                <field name="check_date" optional="show"/>
                <field name="pinned_date"/>
                <field name="pinned_by_id" optional="hide"/>
                <button string="Print PDF" name="%(action_report_qc_job_checksheet)d" type="action" icon="fa-print"/>
            </list>
        </field>
    </record>

    <record id="view_qc_job_checksheet_form" model="ir.ui.view">
        <field name="name">qc.job.checksheet.form</field>
        <field name="model">qc.job.checksheet</field>
        <field name="arch" type="xml">
            <form string="Job Check Sheet" create="0" duplicate="0" delete="0">
                <header>
                    <button string="Print PDF" name="%(action_report_qc_job_checksheet)d" type="action" class="oe_highlight"/>
                    <button string="Open Check Sheet" name="action_open_checksheet" type="object"/>
                </header>
                <div class="alert alert-info mb-0" role="alert" invisible="not update_available">
                    The Model has a newer Released Revision of this sheet (Rev <field name="latest_revision" class="d-inline"/>).
                    Ask for a change of Revision from the Job's QC page; an Approver approves it.
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id" readonly="1"/>
                            <field name="type_id" readonly="1"/>
                            <field name="checksheet_id" readonly="1"/>
                            <field name="latest_revision"/>
                            <field name="model_id"/>
                            <field name="check_date"/>
                        </group>
                        <group>
                            <field name="machine_serial"/>
                            <field name="engine_number"/>
                            <field name="customer"/>
                            <field name="job_status"/>
                            <field name="pinned_date"/>
                            <field name="pinned_by_id"/>
                            <field name="update_available" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revision Change Requests" name="changes">
                            <field name="change_ids" readonly="1">
                                <list>
                                    <field name="from_revision"/>
                                    <field name="to_revision"/>
                                    <field name="reason"/>
                                    <field name="requested_by_id"/>
                                    <field name="requested_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qc_job_checksheet_search" model="ir.ui.view">
        <field name="name">qc.job.checksheet.search</field>
        <field name="model">qc.job.checksheet</field>
        <field name="arch" type="xml">
            <search string="Search Job Check Sheets">
                <field name="job_id"/>
                <field name="model_id"/>
                <field name="type_id"/>
                <field name="reference"/>
                <filter string="Outdated (newer Rev on the Model)" name="outdated" domain="[('update_available', '=', True)]"/>
                <separator/>
                <filter string="Open Jobs" name="open_jobs" domain="[('job_status', 'in', ['in_progress', 'on_hold'])]"
                        help="Jobs In Progress or On Hold."/>
                <filter string="Closed Jobs" name="closed_jobs" domain="[('job_status', 'in', ['eol', 'cancelled'])]"/>
                <separator/>
                <filter string="Revision" name="group_revision" context="{'group_by': 'checksheet_id'}"/>
                <filter string="Job" name="group_job" context="{'group_by': 'job_id'}"/>
                <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_qc_job_checksheet" model="ir.actions.act_window">
        <field name="name">Job Check Sheets</field>
        <field name="res_model">qc.job.checksheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Job has printed a check sheet yet</p>
            <p>A Job's check sheet appears here the first time it is printed from the Job's QC page.
               It keeps the Revision printed then, even after the Model gets a newer one.</p>
        </field>
    </record>

</odoo>
