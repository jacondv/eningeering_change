<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_project_inherit_office_documents" model="ir.ui.view">
        <field name="name">project.project.form.inherit.office.documents</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page name="office_documents" string="Documents" invisible="not id">
                    <field name="office_document_count" widget="jacon_office_documents" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
