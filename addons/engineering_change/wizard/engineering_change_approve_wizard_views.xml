<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_engineering_change_approve_wizard_form" model="ir.ui.view">
        <field name="name">engineering.change.approve.wizard.form</field>
        <field name="model">engineering.change.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Request">
                <field name="change_id" invisible="1"/>
                <field name="approve_by" invisible="1"/>
                <group>
                    <field name="note" placeholder="Comment on this approval..."/>
                </group>
                <footer>
                    <button name="action_confirm_approve" type="object" string="Confirm Approve" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
