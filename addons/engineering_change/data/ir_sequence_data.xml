<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_engineering_change" model="ir.sequence">
        <field name="name">Engineering Change Request No</field>
        <field name="code">engineering.change</field>
        <field name="prefix">%(y)s%(month)s-</field>
        <field name="padding">3</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Bare counter only (no prefix/suffix, no date_range) - the yymmDCxx
         format is built in Python (see EngineeringChange._next_dcr_no()),
         which also resets number_next_actual back to 1 whenever the
         calendar month changes. A single persistent sequence is reused
         forever rather than creating a new ir.sequence record every
         month. -->
    <record id="seq_engineering_change_dcr" model="ir.sequence">
        <field name="name">Engineering Change DCR No (counter)</field>
        <field name="code">engineering.change.dcr</field>
        <field name="padding">2</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">False</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
