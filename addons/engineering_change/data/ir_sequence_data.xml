<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_engineering_change" model="ir.sequence">
        <field name="name">Engineering Change Request No</field>
        <field name="code">engineering.change</field>
        <field name="prefix">%(y)s%(month)s-</field>
        <field name="padding">3</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Legacy: generated DCR Nos (yearly counter, e.g. 2026DC001) before
         the format changed to a monthly counter (yymmDCxx, e.g. 2608DC01).
         Kept only so those already-issued numbers keep resolving/showing
         up correctly - no longer used to generate new ones, see
         EngineeringChange._next_dcr_no(), which creates its own
         "engineering.change.dcr.<yymm>" sequence per month instead. -->
    <record id="seq_engineering_change_dcr" model="ir.sequence">
        <field name="name">Engineering Change DCR No (legacy, yearly)</field>
        <field name="code">engineering.change.dcr</field>
        <field name="prefix">%(year)sDC</field>
        <field name="padding">3</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
