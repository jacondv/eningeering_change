<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_engineering_change" model="ir.module.category">
            <field name="name">Jacon - Engineering Change</field>
            <field name="sequence">30</field>
        </record>

        <!-- Each capability below sits on its OWN privilege (1 group per privilege),
             so they render as independent checkboxes in Settings > Users > Access Rights
             instead of a mutually-exclusive radio set. Any combination can be granted to
             a single user: e.g. a user can be both "Request" and "BOC Approve" at once,
             or hold "Delete" without being a full "Manager Approve". -->

        <record id="privilege_ec_view" model="res.groups.privilege">
            <field name="name">View</field>
            <field name="category_id" ref="module_category_engineering_change"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_ec_request" model="res.groups.privilege">
            <field name="name">Request</field>
            <field name="category_id" ref="module_category_engineering_change"/>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_ec_bod_approve" model="res.groups.privilege">
            <field name="name">BOC Approve</field>
            <field name="category_id" ref="module_category_engineering_change"/>
            <field name="sequence">30</field>
        </record>

        <record id="privilege_ec_manager_approve" model="res.groups.privilege">
            <field name="name">Line Manager Approve</field>
            <field name="category_id" ref="module_category_engineering_change"/>
            <field name="sequence">40</field>
        </record>

        <record id="privilege_ec_head_office_approve" model="res.groups.privilege">
            <field name="name">Engineering Head Approve</field>
            <field name="category_id" ref="module_category_engineering_change"/>
            <field name="sequence">42</field>
        </record>

        <record id="privilege_ec_delete" model="res.groups.privilege">
            <field name="name">Delete</field>
            <field name="category_id" ref="module_category_engineering_change"/>
            <field name="sequence">50</field>
        </record>

        <record id="privilege_ec_close" model="res.groups.privilege">
            <field name="name">Close</field>
            <field name="category_id" ref="module_category_engineering_change"/>
            <field name="sequence">45</field>
        </record>

        <record id="privilege_ec_edit_dcr_no" model="res.groups.privilege">
            <field name="name">Edit DCR Number</field>
            <field name="category_id" ref="module_category_engineering_change"/>
            <field name="sequence">47</field>
        </record>

        <record id="group_ec_user" model="res.groups">
            <field name="name">View</field>
            <field name="privilege_id" ref="privilege_ec_view"/>
            <field name="comment">Can view every Engineering Change request (read-only). Granted automatically to every Internal User.</field>
        </record>

        <record id="group_ec_engineer" model="res.groups">
            <field name="name">Request</field>
            <field name="privilege_id" ref="privilege_ec_request"/>
            <field name="implied_ids" eval="[(4, ref('group_ec_user'))]"/>
            <field name="comment">Can create, edit and submit Engineering Change requests.</field>
        </record>

        <record id="group_ec_bod" model="res.groups">
            <field name="name">BOC Approve</field>
            <field name="privilege_id" ref="privilege_ec_bod_approve"/>
            <field name="implied_ids" eval="[(4, ref('group_ec_user'))]"/>
            <field name="comment">Can approve/reject DCR requests at the final BOC Approval stage. View + Comment only - cannot edit request content directly.</field>
        </record>

        <record id="group_ec_manager" model="res.groups">
            <field name="name">Line Manager Approve</field>
            <field name="privilege_id" ref="privilege_ec_manager_approve"/>
            <field name="implied_ids" eval="[(6, 0, [ref('group_ec_user')])]"/>
            <field name="comment">Can approve/reject at the first (Line Manager) approval stage, close/reopen requests, and manage sequences/groups. BOC Approve is a fully independent privilege, not included here.</field>
        </record>

        <record id="group_ec_head_office" model="res.groups">
            <field name="name">Engineering Head Approve</field>
            <field name="privilege_id" ref="privilege_ec_head_office_approve"/>
            <field name="implied_ids" eval="[(4, ref('group_ec_manager'))]"/>
            <field name="comment">Can approve/reject at the second (Engineering Head) approval stage, between Line Manager and BOC. Includes every Line Manager Approve capability.</field>
        </record>

        <record id="group_ec_delete" model="res.groups">
            <field name="name">Delete</field>
            <field name="privilege_id" ref="privilege_ec_delete"/>
            <field name="comment">Can permanently delete Engineering Change requests at any stage, after confirming their own password. Independent of the other roles - grant it to whoever should be allowed to clean up requests.</field>
        </record>

        <record id="group_ec_close" model="res.groups">
            <field name="name">Close</field>
            <field name="privilege_id" ref="privilege_ec_close"/>
            <field name="implied_ids" eval="[(4, ref('group_ec_user'))]"/>
            <field name="comment">Can close a Request once it reaches the Sales phase, without needing full Manager Approve rights. Manager Approve can always close as well.</field>
        </record>

        <record id="group_ec_edit_dcr_no" model="res.groups">
            <field name="name">Edit DCR Number</field>
            <field name="privilege_id" ref="privilege_ec_edit_dcr_no"/>
            <field name="implied_ids" eval="[(4, ref('group_ec_user'))]"/>
            <field name="comment">Can directly edit a request's DCR Number field, bypassing the normal rule that it's only ever set automatically (on BOC approval, or when Manager/Admin changes the Request Type after approval). For one-off manual corrections - e.g. fixing a typo or a number issued under an old numbering format. Independent of the other roles.</field>
        </record>

    </data>
</odoo>
