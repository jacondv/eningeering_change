<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             MODEL: engineering.change
             ============================================================
             Visibility is unconditional and identical for every role: everyone with any
             Engineering Change group sees every request, regardless of approval role or
             workflow state. Only the ability to WRITE/CREATE/DELETE differs by role
             (separate rules below), which is what actually gates approve/reject (those
             are just writes to `state` via the workflow methods, guarded further in
             EngineeringChange.write()) and deletion.

             Group membership note used throughout this file: Request/BOC/Line Manager Approve
             each imply View (group_ec_user) via `implied_ids`, so a rule scoped to
             group_ec_user already covers all of them. BOC Approve is a fully independent
             privilege - Line Manager/Head Manager Approve do NOT imply it, so any rule that
             needs to include BOC must list group_ec_bod explicitly (see
             ec_change_rule_approve_write below). group_ec_delete is likewise an
             intentionally independent capability, listed explicitly wherever it needs to
             participate. -->
        <record id="ec_change_rule_view_all" model="ir.rule">
            <field name="name">EC Change: everyone sees every request</field>
            <field name="model_id" ref="model_engineering_change"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_ec_user')), (4, ref('group_ec_delete'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="ec_change_rule_request_write" model="ir.rule">
            <field name="name">EC Change: Request holders can create and edit</field>
            <field name="model_id" ref="model_engineering_change"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_ec_engineer')), (4, ref('group_ec_manager'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="ec_change_rule_approve_write" model="ir.rule">
            <field name="name">EC Change: BOC/Manager Approve holders can edit (approve/reject)</field>
            <field name="model_id" ref="model_engineering_change"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_ec_bod')), (4, ref('group_ec_manager'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Close holders don't get general write access to the request - only
             enough to flip it to Done via action_close_request(), which itself
             enforces "state == sale" and re-checks group membership. -->
        <record id="ec_change_rule_close_write" model="ir.rule">
            <field name="name">EC Change: Close holders can close a Sales-phase request</field>
            <field name="model_id" ref="model_engineering_change"/>
            <field name="domain_force">[('state','=','sale')]</field>
            <field name="groups" eval="[(4, ref('group_ec_close'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Related Drawings (document_ids) stay editable by the Engineer or any
             Implement Team member while the request is at the Design stage - even
             if they hold no Approve role at all (just group_ec_user/group_ec_engineer).
             The field-level guard in EngineeringChange.write() (_check_field_edit_
             permissions) still restricts this to document_ids only; every other
             field remains gated as before. -->
        <record id="ec_change_rule_implement_write" model="ir.rule">
            <field name="name">EC Change: Engineer/Implement Team can edit Related Drawings at Design stage</field>
            <field name="model_id" ref="model_engineering_change"/>
            <field name="domain_force">['&amp;',('state','=','implement'),'|',('engineer_id','=',user.id),('implement_team_ids','in',[user.id])]</field>
            <field name="groups" eval="[(4, ref('group_ec_user'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="ec_change_rule_delete" model="ir.rule">
            <field name="name">EC Change: Delete holders can delete</field>
            <field name="model_id" ref="model_engineering_change"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_ec_delete'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- ============================================================
             MODEL: engineering.change.document
             ============================================================
             Same Design-stage carve-out as ec_change_rule_implement_write above,
             on the child model itself - the parent-record rule alone isn't
             enough to let a plain Implement Team member add/edit/remove lines
             in the Related Drawings one2many. -->
        <record id="ec_document_rule_implement_write" model="ir.rule">
            <field name="name">EC Document: Engineer/Implement Team can edit at Design stage</field>
            <field name="model_id" ref="model_engineering_change_document"/>
            <field name="domain_force">['&amp;',('change_id.state','=','implement'),'|',('change_id.engineer_id','=',user.id),('change_id.implement_team_ids','in',[user.id])]</field>
            <field name="groups" eval="[(4, ref('group_ec_user'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- ============================================================
             MODEL: engineering.change.action.evidence
             ============================================================
             The model itself and its base ir.model.access.csv row (granting
             base.group_user full CRUD) live in jacon_core, not here - see that
             row's cross-reference comment on EngineeringChangeActionEvidence.
             The rules below are the real restriction: a plain base.group_user
             holder with none of the EC groups matches none of them and gets
             no rows at all, despite jacon_core's own ACL looking permissive. -->

        <record id="ec_evidence_rule_assignee" model="ir.rule">
            <field name="name">EC Evidence: assignee manages evidence on their own task</field>
            <field name="model_id" ref="jacon_core.model_engineering_change_action_evidence"/>
            <field name="domain_force">[('task_id.user_ids','in',[user.id])]</field>
            <field name="groups" eval="[(4, ref('group_ec_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Request/BOC Approve can see and add evidence on any EC task, but hard-delete
             is reserved for the task's own assignee (their own evidence, handled by
             ec_evidence_rule_assignee above) or Manager Approve (any evidence, below). -->
        <record id="ec_evidence_rule_engineer" model="ir.rule">
            <field name="name">EC Evidence: Request/BOC full visibility (no delete)</field>
            <field name="model_id" ref="jacon_core.model_engineering_change_action_evidence"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_ec_engineer')), (4, ref('group_ec_bod'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="ec_evidence_rule_manager" model="ir.rule">
            <field name="name">EC Evidence: Manager Approve full access</field>
            <field name="model_id" ref="jacon_core.model_engineering_change_action_evidence"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_ec_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- ============================================================
             MODEL: project.task (Engineering Change actions)
             ============================================================
             These rules are scoped to our own groups and to change_id!=False, so they
             only affect EC-related tasks; they don't touch normal Project app access. -->
        <record id="ec_task_rule_view_all" model="ir.rule">
            <field name="name">EC Task: everyone sees every EC task</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('change_id','!=',False)]</field>
            <field name="groups" eval="[(4, ref('group_ec_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="ec_task_rule_user_write" model="ir.rule">
            <field name="name">EC Task: assignee can update status/evidence on their own tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">['&amp;',('change_id','!=',False),'|','|',('user_ids','in',[user.id]),('change_id.engineer_id','=',user.id),('change_id.implement_team_ids','in',[user.id])]</field>
            <field name="groups" eval="[(4, ref('group_ec_user'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Any Request/Engineer role holder may assign an EC task to anyone,
             on any request - not just their own request's Implement Team/Owner.
             Record-level reachability only; ProjectTask._check_ec_write_access
             still limits them to touching `user_ids` (plus the usual
             ASSIGNEE_EDITABLE_FIELDS) unless they're also the Implement Owner
             or Manager Approve. -->
        <record id="ec_task_rule_engineer_assign" model="ir.rule">
            <field name="name">EC Task: any Engineer can assign tasks on any request</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('change_id','!=',False)]</field>
            <field name="groups" eval="[(4, ref('group_ec_engineer'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- The request's Implement Owner (a per-record field, `change_id.implement_owner_id`,
             not a role) is the one who plans out the implementation - only they (or Manager
             Approve, below) may create/edit/delete tasks for their own request. Everyone else,
             including plain assignees and Request/BOC Approve holders, cannot create or delete
             tasks at all; `ec_task_rule_user_write` above still lets an assignee update
             Status/Evidence only (enforced in ProjectTask.write()). -->
        <record id="ec_task_rule_implement_owner_write" model="ir.rule">
            <field name="name">EC Task: Implement Owner manages tasks on their own request</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('change_id.implement_owner_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ec_user'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Manager Approve keeps unconditional full access to every EC task as an
             oversight/override capability, independent of who the Implement Owner is. -->
        <record id="ec_task_rule_manager_write" model="ir.rule">
            <field name="name">EC Task: Manager Approve full write access to EC tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('change_id','!=',False)]</field>
            <field name="groups" eval="[(4, ref('group_ec_manager'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

    </data>
</odoo>
