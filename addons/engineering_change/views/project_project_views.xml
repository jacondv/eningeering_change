<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Projects auto-created to hold a single Engineering Change request's
         Actions/Tasks (is_ec_project=True, see EngineeringChange._link_ec_project)
         are hidden from the Project app's own "Projects" screens - they're an
         implementation detail of the EC workflow, not something to browse or
         edit there. They still show up normally under "Tasks" (untouched here)
         and remain reachable from the Request form's own Project field.

         ir.actions.act_window has no view-style <xpath> inheritance, so these
         are record overrides of project's own actions (same external ID,
         module-prefixed) - both the plain and "group by stage" variant of each
         screen, since project toggles between them per a user setting. -->
    <record id="project.open_view_project_all" model="ir.actions.act_window">
        <field name="domain">[("is_template", "=", False), ("is_ec_project", "=", False)]</field>
    </record>

    <record id="project.open_view_project_all_group_stage" model="ir.actions.act_window">
        <field name="domain">[("is_template", "=", False), ("is_ec_project", "=", False)]</field>
    </record>

    <record id="project.open_view_project_all_config" model="ir.actions.act_window">
        <field name="domain">[("is_template", "=", False), ("is_ec_project", "=", False)]</field>
    </record>

    <record id="project.open_view_project_all_config_group_stage" model="ir.actions.act_window">
        <field name="domain">[("is_template", "=", False), ("is_ec_project", "=", False)]</field>
    </record>

    <!-- jacon_core's own Delete button (project_project_views.xml) has no group
         restriction of its own - jacon_core doesn't depend on engineering_change,
         so it can't reference group_ec_delete directly. Restricted here instead,
         same holder as the "Delete Request" button on the EC form itself, since
         engineering_change already depends on jacon_core and can inherit its view. -->
    <record id="edit_project_inherit_equipment_model_delete_group" model="ir.ui.view">
        <field name="name">project.project.form.inherit.equipment.model.delete.group</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="jacon_core.edit_project_inherit_equipment_model"/>
        <field name="arch" type="xml">
            <button name="action_delete_with_password" position="attributes">
                <attribute name="groups">engineering_change.group_ec_delete</attribute>
            </button>
        </field>
    </record>

</odoo>
