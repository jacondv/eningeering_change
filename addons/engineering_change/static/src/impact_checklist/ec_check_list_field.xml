<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The embedded list of the Impact Checklist, with the bar that sets the status of the picked lines. -->
    <t t-name="engineering_change.EcCheckListField" t-inherit="web.X2ManyField" t-inherit-mode="primary">
        <xpath expr="//ListRenderer" position="before">
            <!-- One row, always: the progress, and (once lines are picked) the buttons beside it. -->
            <div class="o_ec_check_head d-flex align-items-center flex-wrap gap-2 mb-2">
                <span class="text-muted">Done or no change needed:</span>
                <span class="fw-bold" t-esc="progressText"/>
                <t t-if="selectedCount">
                    <span class="o_ec_check_picked ms-3 fw-bold"><t t-esc="selectedCount"/> selected</span>
                    <span class="text-muted">Set to:</span>
                    <button type="button" class="btn btn-sm btn-outline-warning" t-att-disabled="busy.value"
                            t-on-click.stop.prevent="() => this.setStatus('todo')">To do</button>
                    <button type="button" class="btn btn-sm btn-outline-success" t-att-disabled="busy.value"
                            t-on-click.stop.prevent="() => this.setStatus('done')">Done</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-att-disabled="busy.value"
                            t-on-click.stop.prevent="() => this.setStatus('no_change')">No change</button>
                </t>
            </div>
        </xpath>
    </t>

    <!-- Draws nothing: it only marks the tab (see EcCheckTabField). -->
    <t t-name="engineering_change.EcCheckTabField">
        <span class="d-none" t-ref="root"/>
    </t>

</templates>
