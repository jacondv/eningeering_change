<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_engineering_change_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="header" style="width:100%; background-color:#008080; display:flex; align-items:center; padding:5pt 0 6pt 0; box-sizing:border-box; font-family:'Liberation Sans', Arial, sans-serif;">
                    <!-- The header is rendered by wkhtmltopdf in its own document, wrapped by
                         Odoo's minimal_layout in a Bootstrap ".container" body (fixed max-width
                         and side padding) - neutralize it here so the teal bar bleeds edge to
                         edge, same fix as qc_checksheet's report header. -->
                    <style>
                        body.container { max-width:none !important; width:100% !important; margin:0 !important; padding:0 !important; }
                    </style>
                    <table style="width:100%; border-collapse:separate; border-spacing:0;">
                        <tr>
                            <td style="width:20%; padding:7.5pt; vertical-align:middle;">
                                <img src="/engineering_change/static/img/jacon_logo.png" style="max-height:50pt;width:auto; object-fit:contain;"/>
                            </td>
                            <td style="width:80%; text-align:center; vertical-align:middle; color:white;">
                                <div style="font-weight:bold; font-size:16pt;">DESIGN CHANGE REQUEST</div>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="margin:10pt 24pt; font-family:'Liberation Sans', Arial, sans-serif; font-size:10pt;">
                    <div class="page">
                        <style>
                            .ec-section-bar { background-color:#FFC000; font-weight:bold; padding:3pt 6pt; margin-top:10pt; }
                            .ec-label { font-weight:bold; text-decoration:underline; margin:4pt 0 0 0; }
                            table.ec-bordered { border:0.75pt solid #000000; border-collapse:collapse; width:100%; }
                            table.ec-bordered td, table.ec-bordered th { border:0.75pt solid #000000; padding:3pt 6pt; }
                        </style>

                        <table style="width:100%;">
                            <tr>
                                <td><strong>No: </strong><span t-out="o.dcr_no or o.name"/></td>
                                <td style="text-align:right;"><strong>Engineer: </strong><span t-field="o.engineer_id.name"/></td>
                            </tr>
                        </table>

                        <div class="ec-section-bar">1. REQUEST DESCRIPTION:</div>
                        <table class="ec-bordered mt-1">
                            <tr>
                                <td style="width:15%;"><strong>Part No:</strong></td>
                                <td t-out="', '.join(o.document_ids.mapped('name')) or '-'"/>
                            </tr>
                        </table>

                        <p class="mb-0 mt-2"><strong>1.1 Request content</strong></p>
                        <p class="ec-label">Description:</p>
                        <p class="mb-0"><span t-field="o.title"/></p>

                        <p class="mb-0 mt-2"><strong>1.2 Justification Source: </strong><span t-field="o.change_category"/></p>

                        <p class="mb-0 mt-2"><strong>1.3 Request change to:</strong></p>
                        <table class="ec-bordered">
                            <tr>
                                <td style="width:15%;"><strong>Model</strong></td>
                                <td colspan="3" t-out="', '.join(o.affected_model_ids.mapped('name')) or '-'"/>
                            </tr>
                            <tr>
                                <td><strong>Job#</strong></td>
                                <td colspan="3" t-out="', '.join(o.affected_project_ids.mapped('name')) or '-'"/>
                            </tr>
                            <tr>
                                <td><strong>Customer</strong></td>
                                <td t-out="', '.join(o.affected_project_ids.partner_id.mapped('name')) or '-'"/>
                                <td style="width:15%;"><strong>Site</strong></td>
                                <td t-out="', '.join(o.affected_project_ids.site_id.mapped('name')) or '-'"/>
                            </tr>
                        </table>

                        <table class="mt-2" style="width:100%;">
                            <tr>
                                <td style="width:50%;"><strong>Requester: </strong><span t-field="o.engineer_id.name"/></td>
                                <td><strong>Line Manager: </strong></td>
                            </tr>
                            <tr>
                                <td><strong>Date: </strong></td>
                                <td><strong>Date: </strong></td>
                            </tr>
                        </table>

                        <div class="ec-section-bar">2. Request Approval</div>
                        <p class="mb-1 mt-2"><strong>Approved by:</strong></p>
                        <table class="ec-bordered">
                            <thead>
                                <tr style="background-color:#f2f2f2;">
                                    <th>Role</th>
                                    <th>Name</th>
                                    <th>Date</th>
                                    <th>Decision</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.approval_log_ids" t-as="log">
                                    <td><span t-field="log.role"/></td>
                                    <td><span t-field="log.user_id.name"/></td>
                                    <td><span t-field="log.date"/></td>
                                    <td><span t-field="log.decision"/></td>
                                    <td><span t-field="log.note"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="ec-section-bar">3. Implementation Instructions</div>
                        <div class="mt-2" t-field="o.description"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
