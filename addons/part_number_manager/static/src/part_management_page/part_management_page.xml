<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="part_number_manager.PartManagementPage">
        <div class="o_pnm_page">
            <div class="o_pnm_header">
                <div class="o_pnm_header_left">
                    <h2>Part Numbers</h2>
                    <div class="o_pnm_tabs">
                        <button t-attf-class="o_pnm_tab_btn {{ state.activeTab === 'create' ? 'active' : '' }}"
                                t-on-click="() => this.switchTab('create')">Create New</button>
                        <button t-attf-class="o_pnm_tab_btn {{ state.activeTab === 'convert' ? 'active' : '' }}"
                                t-on-click="() => this.switchTab('convert')">Convert Legacy Code</button>
                    </div>
                </div>
            </div>

            <div class="o_pnm_actions">
                <button class="btn btn-secondary" t-on-click="() => this.addRow()">
                    <i class="fa fa-plus"/> Add Row
                </button>
                <button class="btn btn-primary" t-on-click="() => this.onSaveClick()" t-att-disabled="state.isSaving">
                    <i class="fa fa-spinner fa-spin" t-if="state.isSaving"/>
                    Save
                </button>
                <div class="o_pnm_columns_picker">
                    <button class="btn btn-outline-secondary" t-on-click="() => this.toggleColumnPicker()">
                        <i class="fa fa-columns"/> Columns
                    </button>
                    <div class="o_pnm_columns_menu" t-if="state.showColumnPicker">
                        <t t-foreach="toggleableColumns" t-as="col" t-key="col.key">
                            <label class="o_pnm_columns_menu_item">
                                <input type="checkbox"
                                       t-att-checked="state.columnVisibility[col.key]"
                                       t-on-change="() => this.toggleColumnVisibility(col.key)"/>
                                <t t-esc="col.label"/>
                            </label>
                        </t>
                    </div>
                </div>
            </div>

            <div class="o_pnm_table_wrapper">
            <table class="table table-bordered o_pnm_table">
                <colgroup>
                    <col t-if="state.activeTab === 'convert' and state.columnVisibility.legacy" t-attf-style="width: {{state.columnWidths.legacy}}px"/>
                    <col t-if="state.columnVisibility.material_group" t-attf-style="width: {{state.columnWidths.material_group}}px"/>
                    <col t-attf-style="width: {{state.columnWidths.part_number}}px"/>
                    <col t-if="state.columnVisibility.job_number" t-attf-style="width: {{state.columnWidths.job_number}}px"/>
                    <col t-if="state.columnVisibility.short_description" t-attf-style="width: {{state.columnWidths.short_description}}px"/>
                    <col t-if="state.columnVisibility.long_description" t-attf-style="width: {{state.columnWidths.long_description}}px"/>
                    <col t-if="state.columnVisibility.part_type" t-attf-style="width: {{state.columnWidths.part_type}}px"/>
                    <col t-if="state.columnVisibility.vendor" t-attf-style="width: {{state.columnWidths.vendor}}px"/>
                    <col t-if="state.columnVisibility.vendor_ref" t-attf-style="width: {{state.columnWidths.vendor_ref}}px"/>
                    <col t-if="state.columnVisibility.make_buy" t-attf-style="width: {{state.columnWidths.make_buy}}px"/>
                    <col/>
                </colgroup>
                <thead>
                    <tr>
                        <th t-if="state.activeTab === 'convert' and state.columnVisibility.legacy" class="o_pnm_th">Old Part Number
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('legacy', ev)"/>
                        </th>
                        <th t-if="state.columnVisibility.material_group" class="o_pnm_th">Material Group
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('material_group', ev)"/>
                        </th>
                        <th class="o_pnm_th">Part Number
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('part_number', ev)"/>
                        </th>
                        <th t-if="state.columnVisibility.job_number" class="o_pnm_th">Job Number<t t-if="state.activeTab === 'convert'"> (optional)</t>
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('job_number', ev)"/>
                        </th>
                        <th t-if="state.columnVisibility.short_description" class="o_pnm_th">Short Description
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('short_description', ev)"/>
                        </th>
                        <th t-if="state.columnVisibility.long_description" class="o_pnm_th">Long Description
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('long_description', ev)"/>
                        </th>
                        <th t-if="state.columnVisibility.part_type" class="o_pnm_th">Part Type<t t-if="state.activeTab === 'convert'"> (optional)</t>
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('part_type', ev)"/>
                        </th>
                        <th t-if="state.columnVisibility.vendor" class="o_pnm_th">Vendor
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('vendor', ev)"/>
                        </th>
                        <th t-if="state.columnVisibility.vendor_ref" class="o_pnm_th">Vendor Part No.
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('vendor_ref', ev)"/>
                        </th>
                        <th t-if="state.columnVisibility.make_buy" class="o_pnm_th">Make/Buy
                            <span class="o_pnm_col_resize_handle" t-on-mousedown="(ev) => this.onColumnResizeStart('make_buy', ev)"/>
                        </th>
                        <th class="text-end o_pnm_action_col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="state.rows" t-as="row" t-key="row._localId">
                        <tr t-attf-class="{{ row.status === 'success' ? 'o_pnm_row_success' : (row.status === 'error' ? 'o_pnm_row_error' : '') }}">
                            <td t-if="state.activeTab === 'convert' and state.columnVisibility.legacy">
                                <PnmCombobox options="legacyOptions"
                                             text="row.legacyText"
                                             value="row.conversion_legacy_id"
                                             placeholder="'Type to search or enter a new code'"
                                             allowCreate="true"
                                             disabled="row.status === 'success'"
                                             onInput="(text) => this._setLegacyPart(row, text)"
                                             onSelect="(opt) => this._setLegacyPart(row, opt.label)"
                                             onPaste="(ev) => this.onCellPaste(row, 'legacy', ev)"/>
                                <div class="text-muted small" t-if="row.legacyCodeText">
                                    Will create new Old Part Number "<t t-esc="row.legacyCodeText"/>"
                                </div>
                                <div class="text-danger small" t-if="state.errors[row._localId + '_legacy']">
                                    <t t-esc="state.errors[row._localId + '_legacy']"/>
                                </div>
                            </td>
                            <td t-if="state.columnVisibility.material_group">
                                <PnmCombobox options="materialGroupOptions"
                                             text="row.material_group_text"
                                             value="row.material_group_id"
                                             disabled="row.status === 'success'"
                                             onInput="(text) => this._setMaterialGroupText(row, text)"
                                             onSelect="(opt) => this._setMaterialGroupText(row, opt.label)"
                                             onPaste="(ev) => this.onCellPaste(row, 'material_group_id', ev)"/>
                                <div class="text-danger small" t-if="state.errors[row._localId + '_group']">
                                    <t t-esc="state.errors[row._localId + '_group']"/>
                                </div>
                            </td>
                            <td class="o_pnm_number_cell">
                                <t t-if="row.status === 'success'">
                                    <span class="badge text-bg-success user-select-all"><t t-esc="row.resultPartNumber"/></span>
                                </t>
                                <t t-else="">
                                    <t t-if="state.activeTab === 'create'">
                                        <span class="text-muted small">Assigned on Save</span>
                                    </t>
                                    <t t-else="">
                                        <PnmCombobox options="getTargetOptions(row)"
                                                     text="row.targetPartText"
                                                     value="row.existing_new_part_id"
                                                     placeholder="'Blank = generate new'"
                                                     disabled="!row.material_group_id"
                                                     onInput="(text) => this._setTargetPart(row, text)"
                                                     onSelect="(opt) => this._setTargetPart(row, opt.label)"
                                                     onPaste="(ev) => this.onCellPaste(row, 'target_part', ev)"/>
                                        <div class="text-muted small" t-if="!row.material_group_id">
                                            Select a Material Group first
                                        </div>
                                        <div class="text-danger small" t-if="state.errors[row._localId + '_target']">
                                            <t t-esc="state.errors[row._localId + '_target']"/>
                                        </div>
                                    </t>
                                    <div class="text-danger small" t-if="row.errorMessage">
                                        <t t-esc="row.errorMessage"/>
                                    </div>
                                </t>
                            </td>
                            <td t-if="state.columnVisibility.job_number">
                                <PnmCombobox options="jobNumberOptions"
                                             text="row.job_number_text"
                                             value="row.job_number"
                                             disabled="row.status === 'success'"
                                             onInput="(text) => this._setJobNumberText(row, text)"
                                             onSelect="(opt) => this._setJobNumberText(row, opt.label)"
                                             onPaste="(ev) => this.onCellPaste(row, 'job_number', ev)"/>
                                <div class="text-danger small" t-if="state.errors[row._localId + '_job']">
                                    <t t-esc="state.errors[row._localId + '_job']"/>
                                </div>
                            </td>
                            <td t-if="state.columnVisibility.short_description">
                                <t t-call="part_number_manager.PnmClearableField">
                                    <t t-set="record" t-value="row"/>
                                    <t t-set="fieldName" t-value="'short_description'"/>
                                </t>
                                <div class="small"
                                     t-attf-class="{{ (row.short_description || '').length > SHORT_DESCRIPTION_MAX_LENGTH ? 'text-danger' : 'text-muted' }}">
                                    <t t-esc="(row.short_description || '').length"/>/<t t-esc="SHORT_DESCRIPTION_MAX_LENGTH"/>
                                </div>
                                <div class="text-danger small" t-if="state.errors[row._localId + '_short_description']">
                                    <t t-esc="state.errors[row._localId + '_short_description']"/>
                                </div>
                            </td>
                            <td t-if="state.columnVisibility.long_description">
                                <t t-call="part_number_manager.PnmClearableField">
                                    <t t-set="record" t-value="row"/>
                                    <t t-set="fieldName" t-value="'long_description'"/>
                                    <t t-set="multiline" t-value="true"/>
                                </t>
                            </td>
                            <td t-if="state.columnVisibility.part_type">
                                <PnmCombobox options="partTypeOptions"
                                             text="row.part_type_text"
                                             value="row.part_type_id"
                                             placeholder="'-- none (not BOM-built) --'"
                                             disabled="row.status === 'success'"
                                             onInput="(text) => this._setPartTypeText(row, text)"
                                             onSelect="(opt) => this._setPartTypeText(row, opt.label)"
                                             onPaste="(ev) => this.onCellPaste(row, 'part_type_id', ev)"/>
                                <div class="o_pnm_attributes" t-if="row.attributes.length">
                                    <t t-foreach="row.attributes" t-as="attr" t-key="attr.attribute_id">
                                        <div class="o_pnm_attribute_row">
                                            <label><t t-esc="attr.name"/><t t-if="attr.uom"> (<t t-esc="attr.uom"/>)</t></label>
                                            <select t-if="attr.value_type === 'selection'" class="form-select form-select-sm"
                                                    t-att-disabled="row.status === 'success'"
                                                    t-on-change="(ev) => this.onAttributeValueChange(attr, ev.target.value)">
                                                <option value="">-- select --</option>
                                                <t t-foreach="attr.options" t-as="opt" t-key="opt.id">
                                                    <option t-att-value="opt.name" t-att-selected="attr.value === opt.name">
                                                        <t t-esc="opt.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                            <t t-else="" t-call="part_number_manager.PnmClearableField">
                                                <t t-set="record" t-value="attr"/>
                                                <t t-set="fieldName" t-value="'value'"/>
                                                <t t-set="inputType" t-value="attr.value_type === 'float' ? 'number' : 'text'"/>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </td>
                            <td t-if="state.columnVisibility.vendor">
                                <PnmCombobox options="vendorOptions"
                                             text="row.vendor_text"
                                             value="row.vendor_id"
                                             placeholder="'Type to search or enter a new name'"
                                             allowCreate="true"
                                             disabled="row.status === 'success'"
                                             onInput="(text) => this._setVendorText(row, text)"
                                             onSelect="(opt) => this._setVendorText(row, opt.label)"
                                             onPaste="(ev) => this.onCellPaste(row, 'vendor_id', ev)"
                                             onFocusExtra="() => this._searchVendors(row.vendor_text)"/>
                                <div class="text-muted small" t-if="row.vendor_text and !row.vendor_id">
                                    Will create new Vendor "<t t-esc="row.vendor_text"/>"
                                </div>
                            </td>
                            <td t-if="state.columnVisibility.vendor_ref">
                                <t t-call="part_number_manager.PnmClearableField">
                                    <t t-set="record" t-value="row"/>
                                    <t t-set="fieldName" t-value="'vendor_ref'"/>
                                </t>
                            </td>
                            <td t-if="state.columnVisibility.make_buy">
                                <select class="form-select form-select-sm"
                                        t-att-value="row.make_buy || ''"
                                        t-on-change="(ev) => this.onMakeBuyChange(row, ev)"
                                        t-att-disabled="row.status === 'success'">
                                    <option value="">-- select (required) --</option>
                                    <option value="make">Make</option>
                                    <option value="buy">Buy</option>
                                </select>
                                <div class="text-danger small" t-if="state.errors[row._localId + '_make_buy']">
                                    <t t-esc="state.errors[row._localId + '_make_buy']"/>
                                </div>
                            </td>
                            <td class="text-end o_pnm_action_col">
                                <button class="btn btn-sm btn-outline-danger"
                                        t-if="row.status !== 'success'"
                                        t-on-click="() => this.removeRow(row._localId)">
                                    <i class="fa fa-trash"/>
                                </button>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            </div>

            <PnmRecentPartsTable t-if="state.recentParts.length"
                                 parts="state.recentParts"
                                 onOpenPart="(id) => this.openPart(id)"
                                 onClear="() => this.clearRecentParts()"/>
        </div>
    </t>

    <!-- A plain input/textarea with the same quick clear as PnmCombobox.
         Expects: record, fieldName, row; optionally multiline, inputType. -->
    <t t-name="part_number_manager.PnmClearableField">
        <div class="o_pnm_clearable">
            <textarea t-if="multiline" class="form-control form-control-sm o_pnm_long_desc" rows="1"
                      t-model="record[fieldName]"
                      t-on-paste="(ev) => this.onCellPaste(record, fieldName, ev)"
                      t-att-disabled="row.status === 'success'"/>
            <input t-else="" t-att-type="inputType || 'text'" class="form-control form-control-sm"
                   t-model="record[fieldName]"
                   t-on-paste="(ev) => this.onCellPaste(record, fieldName, ev)"
                   t-att-disabled="row.status === 'success'"/>
            <button type="button" class="o_pnm_clear_btn" tabindex="-1" title="Clear"
                    t-if="record[fieldName] and row.status !== 'success'"
                    t-on-mousedown.prevent="(ev) => this.clearField(record, fieldName, ev)">
                <i class="fa fa-times"/>
            </button>
        </div>
    </t>
</templates>
