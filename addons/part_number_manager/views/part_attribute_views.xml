<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pnm_part_attribute_list" model="ir.ui.view">
        <field name="name">part_number_manager.part_attribute.list</field>
        <field name="model">part_number_manager.part_attribute</field>
        <field name="arch" type="xml">
            <list js_class="jacon_core_list">
                <field name="name"/>
                <field name="value_type"/>
                <field name="uom"/>
            </list>
        </field>
    </record>

    <record id="view_pnm_part_attribute_form" model="ir.ui.view">
        <field name="name">part_number_manager.part_attribute.form</field>
        <field name="model">part_number_manager.part_attribute</field>
        <field name="arch" type="xml">
            <form string="Part Attribute">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="value_type"/>
                        <field name="uom" invisible="value_type != 'float'"/>
                    </group>
                    <field name="option_ids" invisible="value_type != 'selection'">
                        <list editable="bottom">
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pnm_part_attribute" model="ir.actions.act_window">
        <field name="name">Part Attributes</field>
        <field name="res_model">part_number_manager.part_attribute</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
