<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_pnm_part" model="ir.ui.view">
        <field name="name">product.template.form.pnm.part</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="pnm_part_id" invisible="1"/>
                <button name="action_open_pnm_part" type="object" class="oe_stat_button"
                        icon="fa-barcode" invisible="not pnm_part_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Part Number</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
