<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pnm_part_type_list" model="ir.ui.view">
        <field name="name">part_number_manager.part_type.list</field>
        <field name="model">part_number_manager.part_type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="attribute_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_pnm_part_type_form" model="ir.ui.view">
        <field name="name">part_number_manager.part_type.form</field>
        <field name="model">part_number_manager.part_type</field>
        <field name="arch" type="xml">
            <form string="Part Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="attribute_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pnm_part_type" model="ir.actions.act_window">
        <field name="name">Part Types</field>
        <field name="res_model">part_number_manager.part_type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
