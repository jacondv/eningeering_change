<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_pnm_root" name="Part Numbers"
          groups="part_number_manager.group_pnm_user,jacon_core.group_head_office"/>

    <menuitem id="menu_pnm_all" name="All Part Numbers"
          parent="menu_pnm_root"
          groups="part_number_manager.group_pnm_user"
          action="action_pnm_part_number"
          sequence="10"/>

    <menuitem id="menu_pnm_create_convert" name="Create / Convert"
          parent="menu_pnm_root"
          groups="part_number_manager.group_pnm_user"
          action="action_part_management_page"
          sequence="20"/>

    <menuitem id="menu_pnm_pending_approval" name="Pending Approval"
          parent="menu_pnm_root"
          groups="jacon_core.group_head_office"
          action="action_pnm_part_number_pending_approval"
          sequence="85"/>

    <!-- group_pnm_manager implies group_pnm_config_viewer, so Managers still
         see this - but group_pnm_config_viewer can also be granted on its
         own (Settings > Users > a user's form > Other Extra Rights) to let
         a regular User view Configuration read-only without Manager's
         create/edit/delete rights. -->
    <menuitem id="menu_pnm_configuration" name="Configuration"
          parent="menu_pnm_root"
          groups="part_number_manager.group_pnm_config_viewer"
          sequence="90"/>

    <menuitem id="menu_pnm_configuration_material_category" name="Main Categories"
          parent="menu_pnm_configuration"
          action="action_pnm_material_category"
          sequence="5"/>

    <menuitem id="menu_pnm_configuration_material_group" name="Material Groups"
          parent="menu_pnm_configuration"
          action="action_pnm_material_group"
          sequence="10"/>

    <menuitem id="menu_pnm_configuration_part_type" name="Part Types"
          parent="menu_pnm_configuration"
          action="action_pnm_part_type"
          sequence="20"/>

    <menuitem id="menu_pnm_configuration_part_attribute" name="Part Attributes"
          parent="menu_pnm_configuration"
          action="action_pnm_part_attribute"
          sequence="30"/>

    <!-- Same screen as Invoicing's own Configuration > Accounting >
         Currencies (base.action_currency_form) - just reachable without
         needing Invoicing/Accounting access, since Part Number pricing
         depends on it too (activate a Currency here, add its exchange
         Rates on its own form). -->
    <menuitem id="menu_pnm_configuration_currency" name="Currencies"
          parent="menu_pnm_configuration"
          action="base.action_currency_form"
          sequence="40"/>

</odoo>
