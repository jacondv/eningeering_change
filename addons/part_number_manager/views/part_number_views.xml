<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pnm_part_number_list" model="ir.ui.view">
        <field name="name">part_number_manager.part_number.list</field>
        <field name="model">part_number_manager.part_number</field>
        <field name="arch" type="xml">
            <list js_class="jacon_core_list" decoration-muted="state == 'obsolete' or not active">
                <field name="part_number"/>
                <field name="short_description" optional="show"/>
                <field name="long_description" optional="show" class="o_pnm_long_description_cell"/>
                <field name="legacy_codes_display" string="Legacy Code" optional="show"/>
                <field name="replacement_display" string="Replaced By" optional="show"/>
                <field name="job_number" optional="show"/>
                <field name="part_type_id" optional="show"/>
                <field name="make_buy" optional="hide"/>
                <field name="vendor_id" optional="show"/>
                <field name="vendor_ref" string="Vendor PartNo" optional="show"/>
                <field name="reference_price" optional="hide" digits="[16, 0]"/>
                <field name="lead_time" optional="hide"/>
                <field name="attribute_display" string="Attributes" optional="hide"/>
                <field name="display_description" optional="hide"/>
                <field name="display_description_vn" optional="hide"/>
                <field name="create_date" string="Created On" optional="show"/>
                <field name="create_uid" string="Created By" optional="show"/>
                <field name="date_created" optional="hide" widget="pnm_date_full"/>
                <field name="state" widget="badge" optional="show"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'obsolete'"/>
                <field name="approval_state" widget="badge" optional="show"
                       decoration-warning="approval_state == 'pending'"
                       decoration-success="approval_state == 'approved'"/>
                <field name="material_group_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pnm_part_number_form" model="ir.ui.view">
        <field name="name">part_number_manager.part_number.form</field>
        <field name="model">part_number_manager.part_number</field>
        <field name="arch" type="xml">
            <form string="Part Number">
                <header>
                    <field name="is_unlocked" widget="part_number_edit_lock_button" nolabel="1"/>
                    <field name="approval_state" widget="badge" invisible="approval_state == 'approved'"
                           decoration-warning="approval_state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,obsolete,y,tbd"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="part_number" readonly="1" placeholder="Generated on Save"/>
                        </h1>
                        <field name="replacement_display" readonly="1" invisible="not replacement_display"/>
                    </div>
                    <group col="3">
                        <group>
                            <field name="material_group_id" required="1"/>
                            <field name="job_number"/>
                            <field name="short_description"/>
                            <field name="date_created" options="{'show_time': true}"/>
                        </group>
                        <group style="grid-template-columns: fit-content(220px) minmax(0, 1fr);">
                            <field name="display_description"/>
                            <field name="display_description_vn"/>
                            <field name="part_type_id"/>
                            <field name="make_buy"/>
                        </group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="vendor_ref"/>
                            <field name="reference_price" digits="[16, 0]"/>
                            <field name="lead_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="long_description"/>
                        </page>
                        <page string="Attributes" name="attributes">
                            <field name="attribute_value_ids">
                                <list editable="bottom">
                                    <field name="attribute_id"/>
                                    <field name="value_type" column_invisible="1"/>
                                    <field name="value_char" invisible="value_type != 'char'"/>
                                    <field name="value_float" invisible="value_type != 'float'"/>
                                    <field name="value_option_id" invisible="value_type != 'selection'"
                                           domain="[('attribute_id', '=', attribute_id)]"/>
                                    <field name="option_description" readonly="1" string="Option Description"
                                           invisible="value_type != 'selection'"/>
                                    <field name="display_value" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Legacy / New Code Mapping" name="mapping">
                            <group string="Legacy codes replaced by this part">
                                <field name="superseded_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="legacy_part_id"/>
                                    </list>
                                </field>
                            </group>
                            <group string="New codes that replaced this part">
                                <field name="supersedes_ids" nolabel="1">
                                    <list>
                                        <field name="new_part_id"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pnm_part_number_search" model="ir.ui.view">
        <field name="name">part_number_manager.part_number.search</field>
        <field name="model">part_number_manager.part_number</field>
        <field name="arch" type="xml">
            <search>
                <field name="short_description" string="All"
                       filter_domain="['|','|','|','|','|',
                           ('part_number', 'ilike', self),
                           ('short_description', 'ilike', self),
                           ('long_description', 'ilike', self),
                           ('display_description', 'ilike', self),
                           ('legacy_codes_display', 'ilike', self),
                           ('replacement_display', 'ilike', self)]"/>
                <field name="part_number"/>
                <field name="short_description" string="Short Description"/>
                <field name="long_description"/>
                <field name="display_description"/>
                <field name="material_group_id"/>
                <field name="job_number" string="Project"/>
                <field name="part_type_id"/>
                <field name="vendor_id"/>
                <field name="legacy_codes_display" string="Legacy Code"/>
                <field name="replacement_display" string="Replaced By"/>
                <field name="create_uid" string="Created By"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Obsolete" name="filter_obsolete" domain="[('state', '=', 'obsolete')]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Material Group" name="groupby_material_group" context="{'group_by': 'material_group_id'}"/>
                    <filter string="Part Type" name="groupby_part_type" context="{'group_by': 'part_type_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Created By" name="groupby_create_uid" context="{'group_by': 'create_uid'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pnm_part_number" model="ir.actions.act_window">
        <field name="name">Part Numbers</field>
        <field name="res_model">part_number_manager.part_number</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pnm_part_number_search"/>
        <field name="context">{'search_default_filter_draft': 0}</field>
    </record>

    <!-- Same list as "All Part Numbers" above, minus the "New" button -
         every row here was auto-generated (Create/Convert page or Import),
         never meant to be hand-added from this queue. -->
    <record id="view_pnm_part_number_pending_approval_list" model="ir.ui.view">
        <field name="name">part_number_manager.part_number.pending_approval.list</field>
        <field name="model">part_number_manager.part_number</field>
        <field name="inherit_id" ref="view_pnm_part_number_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
        </field>
    </record>

    <!-- Pending Approval: pre-filtered, no "New" - Head Engineer selects/
         deselects rows (Select All, then untick a few, is the expected
         flow) and uses the Approve/Reject actions below from the list's
         own Action menu. -->
    <record id="action_pnm_part_number_pending_approval" model="ir.actions.act_window">
        <field name="name">Pending Approval</field>
        <field name="res_model">part_number_manager.part_number</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_pnm_part_number_pending_approval_list"/>
        <field name="search_view_id" ref="view_pnm_part_number_search"/>
        <field name="domain">[('approval_state', '=', 'pending')]</field>
        <field name="context">{'search_default_filter_draft': 0}</field>
    </record>

    <record id="action_pnm_part_number_approve" model="ir.actions.server">
        <field name="name">Approve</field>
        <field name="model_id" ref="model_part_number_manager_part_number"/>
        <field name="binding_model_id" ref="model_part_number_manager_part_number"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Approve Part Number(s)',
    'res_model': 'part_number_manager.part_number_approve_wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_ids': records.ids},
}</field>
    </record>

    <record id="action_pnm_part_number_reject" model="ir.actions.server">
        <field name="name">Reject</field>
        <field name="model_id" ref="model_part_number_manager_part_number"/>
        <field name="binding_model_id" ref="model_part_number_manager_part_number"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Reject Part Number(s)',
    'res_model': 'part_number_manager.part_number_reject_wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_ids': records.ids},
}</field>
    </record>

</odoo>
