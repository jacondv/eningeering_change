<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pnm_part_number_reject_wizard_form" model="ir.ui.view">
        <field name="name">part_number_manager.part_number_reject_wizard.form</field>
        <field name="model">part_number_manager.part_number_reject_wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Part Number(s)">
                <p>Reject the selected Part Number(s)? They will be Archived (hidden from default lists, not deleted).</p>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_pnm_part_number_approve_wizard_form" model="ir.ui.view">
        <field name="name">part_number_manager.part_number_approve_wizard.form</field>
        <field name="model">part_number_manager.part_number_approve_wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Part Number(s)">
                <p>Approve the selected Part Number(s)?</p>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
