<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_part_number_manager" model="ir.module.category">
            <field name="name">Part Number Manager</field>
            <field name="sequence">31</field>
        </record>

        <record id="privilege_pnm_user" model="res.groups.privilege">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_part_number_manager"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_pnm_manager" model="res.groups.privilege">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_part_number_manager"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_pnm_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_pnm_user"/>
            <field name="comment">Can create/convert part numbers and view configuration (Material Groups, Part Types, Attributes) read-only.</field>
        </record>

        <record id="group_pnm_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_pnm_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_pnm_user'))]"/>
            <field name="comment">Can manage configuration (Material Groups, Part Types, Attributes) and delete part numbers.</field>
        </record>

    </data>
</odoo>
