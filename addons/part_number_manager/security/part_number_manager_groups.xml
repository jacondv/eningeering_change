<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_part_number_manager" model="ir.module.category">
            <field name="name">Jacon - Part Number Manager</field>
            <field name="sequence">31</field>
        </record>

        <record id="privilege_pnm_user" model="res.groups.privilege">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_part_number_manager"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_pnm_manager" model="res.groups.privilege">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_part_number_manager"/>
            <field name="sequence">20</field>
        </record>

        <!-- Independent of User/Manager - granted on its own (Settings > Users
             > a user's own form > "Other Extra Rights") to let someone see the
             Configuration menus (Part Number Manager and Hose And Fitting)
             read-only, without also handing them Part Number create/delete
             rights (group_pnm_user/group_pnm_manager). -->
        <record id="privilege_pnm_config_viewer" model="res.groups.privilege">
            <field name="name">Configuration Viewer</field>
            <field name="category_id" ref="module_category_part_number_manager"/>
            <field name="sequence">15</field>
        </record>

        <record id="group_pnm_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_pnm_user"/>
            <field name="comment">Can create/convert part numbers and view configuration (Material Groups, Part Types, Attributes) read-only.</field>
        </record>

        <record id="group_pnm_config_viewer" model="res.groups">
            <field name="name">Configuration Viewer</field>
            <field name="privilege_id" ref="privilege_pnm_config_viewer"/>
            <field name="comment">Read-only access to the Configuration menus (Part Number Manager: Main Categories/Material Groups/Part Types/Part Attributes; Hose And Fitting: Config). Does not grant Part Number create/edit/delete rights.</field>
        </record>

        <record id="group_pnm_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_pnm_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_pnm_user')), (4, ref('group_pnm_config_viewer'))]"/>
            <field name="comment">Can manage configuration (Material Groups, Part Types, Attributes) and delete part numbers.</field>
        </record>

    </data>
</odoo>
