<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_hfm_root" name="Hose And Fitting"
          parent="part_number_manager.menu_pnm_root"
          groups="part_number_manager.group_pnm_user"
          sequence="30"/>

    <menuitem id="menu_hfm_builder" name="Create List"
          parent="menu_hfm_root"
          action="action_hfm_builder"
          sequence="10"/>

    <menuitem id="menu_hfm_lines" name="All Lines"
          parent="menu_hfm_root"
          action="action_hfm_job_hose_line"
          sequence="20"/>

    <!-- group_pnm_manager implies group_pnm_config_viewer (see
         part_number_manager_groups.xml), so Managers still see this -
         group_pnm_config_viewer can also be granted on its own for full
         edit access, same as part_number_manager.menu_pnm_configuration. -->
    <menuitem id="menu_hfm_config" name="Hose And Fitting Config"
          parent="part_number_manager.menu_pnm_configuration"
          groups="part_number_manager.group_pnm_config_viewer"
          action="action_hfm_config"
          sequence="40"/>

    <menuitem id="menu_hfm_function" name="Functions"
          parent="part_number_manager.menu_pnm_configuration"
          groups="part_number_manager.group_pnm_manager"
          action="action_hfm_function"
          sequence="50"/>

</odoo>
