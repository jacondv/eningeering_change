<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pnd_document_type_list" model="ir.ui.view">
        <field name="name">pnd.document.type.list</field>
        <field name="model">pnd.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_pnd_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">pnd.document.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
