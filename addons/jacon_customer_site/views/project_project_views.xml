<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_project_inherit_site" model="ir.ui.view">
        <field name="name">project.project.form.inherit.site</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="site_id" options="{'no_open': True}"/>
            </field>
        </field>
    </record>

    <record id="view_project_inherit_site" model="ir.ui.view">
        <field name="name">project.project.list.inherit.site</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="site_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
