<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_equipment_model" model="ir.module.category">
            <field name="name">Equipment Model</field>
            <field name="sequence">32</field>
        </record>

        <record id="privilege_equipment_model_user" model="res.groups.privilege">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_equipment_model"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_equipment_model_manager" model="res.groups.privilege">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_equipment_model"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_equipment_model_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_equipment_model_user"/>
            <field name="comment">Can view the Equipment Model hierarchy read-only.</field>
        </record>

        <record id="group_equipment_model_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_equipment_model_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_equipment_model_user'))]"/>
            <field name="comment">Can create/edit/delete Equipment Models.</field>
        </record>

    </data>
</odoo>
