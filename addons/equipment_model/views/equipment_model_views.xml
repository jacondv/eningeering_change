<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_model_list" model="ir.ui.view">
        <field name="name">equipment.model.list</field>
        <field name="model">equipment.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="parent_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_model_form" model="ir.ui.view">
        <field name="name">equipment.model.form</field>
        <field name="model">equipment.model</field>
        <field name="arch" type="xml">
            <form string="Equipment Model">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Model name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="category_id"/>
                        <field name="parent_id"/>
                    </group>
                    <field name="description" placeholder="Description..."/>
                    <notebook>
                        <page string="Child Models" name="child_models">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Projects" name="projects" invisible="not project_ids">
                            <field name="project_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_model_search" model="ir.ui.view">
        <field name="name">equipment.model.search</field>
        <field name="model">equipment.model</field>
        <field name="arch" type="xml">
            <search string="Search Equipment Models">
                <field name="name"/>
                <field name="category_id"/>
                <field name="parent_id"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Parent Model" name="group_parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_equipment_model" model="ir.actions.act_window">
        <field name="name">Equipment Models</field>
        <field name="res_model">equipment.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipment_model_search"/>
    </record>

</odoo>
