<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_equipment_model_root" name="Equipment Models"
          groups="equipment_model.group_equipment_model_user"/>

    <!-- First by sequence: it is what opening the app shows. Import and
         Export are buttons on it, not menus of their own. -->
    <menuitem id="menu_equipment_model_dashboard" name="Dashboard"
          parent="menu_equipment_model_root"
          action="action_equipment_model_dashboard"
          sequence="5"/>

    <menuitem id="menu_equipment_model_all" name="Equipment Models"
          parent="menu_equipment_model_root"
          action="action_equipment_model"
          sequence="10"/>

    <menuitem id="menu_equipment_model_family"
          parent="menu_equipment_model_root"
          action="action_equipment_model_family"
          sequence="20"/>

    <menuitem id="menu_equipment_model_category"
          parent="menu_equipment_model_root"
          action="action_equipment_model_category"
          sequence="30"/>

</odoo>
