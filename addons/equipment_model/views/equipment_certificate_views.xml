<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_certificate_hierarchy" model="ir.ui.view">
        <field name="name">equipment.certificate.hierarchy</field>
        <field name="model">equipment.certificate</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids">
                <field name="name"/>
                <field name="child_count"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div class="d-flex flex-column text-center p-2">
                            <field class="fw-bold" name="name"/>
                            <span t-if="record.child_count.raw_value" class="text-muted small">
                                <t t-esc="record.child_count.raw_value"/> sub-item(s)
                            </span>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <record id="view_equipment_certificate_list" model="ir.ui.view">
        <field name="name">equipment.certificate.list</field>
        <field name="model">equipment.certificate</field>
        <field name="arch" type="xml">
            <list default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="child_count" string="Sub-items"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_certificate_form" model="ir.ui.view">
        <field name="name">equipment.certificate.form</field>
        <field name="model">equipment.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificate Reference">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Node name..."/>
                        </h1>
                        <field name="complete_name" readonly="1" class="text-muted"/>
                    </div>
                    <group>
                        <field name="parent_id"/>
                    </group>
                    <notebook>
                        <page string="Sub-items" name="children">
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="child_count" string="Sub-items"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" options="{'collaborative': false}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_certificate_search" model="ir.ui.view">
        <field name="name">equipment.certificate.search</field>
        <field name="model">equipment.certificate</field>
        <field name="arch" type="xml">
            <search string="Search Certificates">
                <field name="name"/>
                <field name="complete_name" string="Full path"/>
                <filter string="Top-level" name="top_level" domain="[('parent_id', '=', False)]"/>
                <filter string="Parent" name="group_parent" context="{'group_by': 'parent_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_equipment_certificate" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">equipment.certificate</field>
        <field name="view_mode">hierarchy,list,form</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'default_parent_id': False}</field>
        <field name="search_view_id" ref="view_equipment_certificate_search"/>
    </record>

    <record id="action_equipment_certificate_explorer" model="ir.actions.client">
        <field name="name">Certificates</field>
        <field name="tag">equipment_certificate_explorer</field>
    </record>

</odoo>
