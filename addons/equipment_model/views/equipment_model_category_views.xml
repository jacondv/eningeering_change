<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_model_category_list" model="ir.ui.view">
        <field name="name">equipment.model.category.list</field>
        <field name="model">equipment.model.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="family_count"/>
                <field name="model_count"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_model_category_form" model="ir.ui.view">
        <field name="name">equipment.model.category.form</field>
        <field name="model">equipment.model.category</field>
        <field name="arch" type="xml">
            <form string="Equipment Model Category">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category name..."/>
                        </h1>
                    </div>
                    <field name="description" placeholder="Description..."/>
                    <notebook>
                        <page string="Product Families" name="families">
                            <field name="family_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="model_count"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_model_category_search" model="ir.ui.view">
        <field name="name">equipment.model.category.search</field>
        <field name="model">equipment.model.category</field>
        <field name="arch" type="xml">
            <search string="Search Equipment Model Categories">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_equipment_model_category" model="ir.actions.act_window">
        <field name="name">Model Categories</field>
        <field name="res_model">equipment.model.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipment_model_category_search"/>
    </record>

</odoo>
