<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_certificate" model="ir.module.category">
            <field name="name">Jacon - Certificate</field>
            <field name="sequence">33</field>
        </record>

        <record id="privilege_certificate_user" model="res.groups.privilege">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_certificate"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_certificate_manager" model="res.groups.privilege">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_certificate"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_certificate_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_certificate_user"/>
            <field name="comment">Can view the Certificate reference tree read-only.</field>
        </record>

        <record id="group_certificate_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_certificate_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_certificate_user'))]"/>
            <field name="comment">Can create/edit/delete Certificate reference entries.</field>
        </record>

    </data>
</odoo>
