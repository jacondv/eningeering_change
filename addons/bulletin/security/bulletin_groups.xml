<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_bulletin" model="ir.module.category">
            <field name="name">Jacon - Bulletin</field>
            <field name="sequence">34</field>
        </record>

        <record id="privilege_bulletin_user" model="res.groups.privilege">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_bulletin"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_bulletin_manager" model="res.groups.privilege">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_bulletin"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_bulletin_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_bulletin_user"/>
            <field name="comment">Can create/edit Bulletins.</field>
        </record>

        <record id="group_bulletin_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_bulletin_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_bulletin_user'))]"/>
            <field name="comment">Can manage Sections and Templates.</field>
        </record>

    </data>
</odoo>
