<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bulletin_template_list" model="ir.ui.view">
        <field name="name">bulletin.template.list</field>
        <field name="model">bulletin.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_bulletin_template_form" model="ir.ui.view">
        <field name="name">bulletin.template.form</field>
        <field name="model">bulletin.template</field>
        <field name="arch" type="xml">
            <form string="Bulletin Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. SAFETY BULLETIN"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="section_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="section_id" options="{'no_open': True}"/>
                            <field name="content_type" column_invisible="1"/>
                            <field name="required"/>
                            <field name="default_approver_id" invisible="content_type != 'authorisation'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bulletin_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">bulletin.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
