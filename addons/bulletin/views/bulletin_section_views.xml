<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bulletin_section_list" model="ir.ui.view">
        <field name="name">bulletin.section.list</field>
        <field name="model">bulletin.section</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="content_type"/>
            </list>
        </field>
    </record>

    <record id="view_bulletin_section_form" model="ir.ui.view">
        <field name="name">bulletin.section.form</field>
        <field name="model">bulletin.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Subject, Issue Description..."/></h1>
                    </div>
                    <group>
                        <field name="content_type"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="default_value" placeholder="Auto-inserted into this Section's content on every new Bulletin..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bulletin_section" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">bulletin.section</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
