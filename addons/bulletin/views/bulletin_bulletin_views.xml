<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bulletin_bulletin_list" model="ir.ui.view">
        <field name="name">bulletin.bulletin.list</field>
        <field name="model">bulletin.bulletin</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="template_id"/>
                <field name="date"/>
                <field name="version" optional="hide"/>
                <field name="user_id"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bulletin_bulletin_form" model="ir.ui.view">
        <field name="name">bulletin.bulletin.form</field>
        <field name="model">bulletin.bulletin</field>
        <field name="arch" type="xml">
            <form string="Bulletin">
                <header>
                    <button name="action_print_pdf" type="object" string="Print PDF" class="btn-primary"
                            invisible="not template_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="date"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="section_ids" widget="bulletin_sections"
                           invisible="not template_id">
                        <list>
                            <field name="sequence"/>
                            <field name="template_section_id" column_invisible="1"/>
                            <field name="section_id"/>
                            <field name="name"/>
                            <field name="content_type"/>
                            <field name="content"/>
                            <field name="approver_id"/>
                            <field name="approver_name"/>
                            <field name="approver_job_title"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert" invisible="template_id">
                        Choose a Template above to fill in this Bulletin.
                    </div>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bulletin_bulletin_search" model="ir.ui.view">
        <field name="name">bulletin.bulletin.search</field>
        <field name="model">bulletin.bulletin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_id"/>
                <field name="user_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_bulletin_bulletin" model="ir.actions.act_window">
        <field name="name">Bulletins</field>
        <field name="res_model">bulletin.bulletin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Bulletin</p>
        </field>
    </record>

</odoo>
