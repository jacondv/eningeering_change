<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jacon_office_document_replace_wizard_form" model="ir.ui.view">
        <field name="name">jacon.office.document.replace.wizard.form</field>
        <field name="model">jacon.office.document.replace.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace File">
                <field name="document_id" invisible="1"/>
                <field name="kind" invisible="1"/>
                <p class="text-muted">
                    The file of this Draft is replaced by the one you choose (same type). Placeholders such as
                    rev are filled again when the file is shown; to keep them, change the original
                    (Download original) rather than the downloaded file.
                </p>
                <group>
                    <field name="upload" filename="upload_filename" string="New file"/>
                    <field name="upload_filename" invisible="1"/>
                </group>
                <footer>
                    <button string="Replace" name="action_confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
