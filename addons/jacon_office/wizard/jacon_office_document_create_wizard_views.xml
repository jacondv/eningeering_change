<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jacon_office_document_create_wizard_form" model="ir.ui.view">
        <field name="name">jacon.office.document.create.wizard.form</field>
        <field name="model">jacon.office.document.create.wizard</field>
        <field name="arch" type="xml">
            <form string="New Document">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="auto_name" invisible="1"/>
                <field name="auto_template_id" invisible="1"/>
                <field name="template_chosen" invisible="1"/>
                <field name="upload_filename" invisible="1"/>
                <group>
                    <field name="template_id" widget="jacon_office_template_picker"/>
                    <field name="kind" widget="radio" options="{'horizontal': true}"
                           invisible="template_id or upload" required="not template_id and not upload"/>
                    <field name="upload" string="Upload" filename="upload_filename"/>
                    <field name="category_id" options="{'no_create': true}"/>
                    <field name="name"/>
                    <field name="description" placeholder="Optional"/>
                </group>
                <footer>
                    <button string="Save and Edit" name="action_create_and_edit" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Save" name="action_create" type="object" data-hotkey="w"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
