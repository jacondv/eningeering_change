<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jacon_office_document_create_wizard_form" model="ir.ui.view">
        <field name="name">jacon.office.document.create.wizard.form</field>
        <field name="model">jacon.office.document.create.wizard</field>
        <field name="arch" type="xml">
            <form string="New Document">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="auto_name" invisible="1"/>
                <field name="upload_filename" invisible="1"/>
                <group>
                    <field name="source" widget="radio" options="{'horizontal': true}"/>
                    <field name="kind" widget="radio" options="{'horizontal': true}"
                           invisible="source != 'new'" required="source == 'new'"/>
                    <field name="upload" filename="upload_filename"
                           invisible="source != 'upload'" required="source == 'upload'"/>
                    <field name="category_id" options="{'no_create': true}"/>
                    <field name="name"/>
                    <field name="description" placeholder="Optional"/>
                </group>
                <footer>
                    <button string="Create and Edit" name="action_create_and_edit" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Create" name="action_create" type="object" data-hotkey="w"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
