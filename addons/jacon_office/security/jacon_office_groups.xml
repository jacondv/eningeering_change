<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_jacon_office" model="ir.module.category">
            <field name="name">Jacon - Office Documents</field>
            <field name="sequence">36</field>
        </record>

        <record id="privilege_jacon_office_user" model="res.groups.privilege">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_jacon_office"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_jacon_office_manager" model="res.groups.privilege">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_jacon_office"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_jacon_office_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_jacon_office_user"/>
            <field name="comment">Can create and edit documents on records they can edit. What a user can actually see or change is decided by their access to the record the document belongs to.</field>
        </record>

        <record id="group_jacon_office_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_jacon_office_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_jacon_office_user'))]"/>
            <field name="comment">Can delete documents and manage categories.</field>
        </record>

        <!-- Every internal user gets the User group: the real gate is access to the
             record a document belongs to, not this group. -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('jacon_office.group_jacon_office_user'))]"/>
        </record>

        <!-- Settings administrators manage Office Documents too (the number of Revs kept...). -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('jacon_office.group_jacon_office_manager'))]"/>
        </record>

    </data>
</odoo>
