<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_jacon_office" model="ir.module.category">
            <field name="name">Jacon - Office Documents</field>
            <field name="sequence">36</field>
        </record>

        <!-- One privilege with three levels, each including the one before: they show as a single
             choice (None / Viewer / Editor / Manager) on a user's form. -->
        <record id="privilege_jacon_office" model="res.groups.privilege">
            <field name="name">Office Documents</field>
            <field name="category_id" ref="module_category_jacon_office"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_jacon_office_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="privilege_id" ref="privilege_jacon_office"/>
            <field name="comment">Can look at documents: the list, the PDF, the Revs, download. What a user can see is also limited by their access to the record the document belongs to.</field>
        </record>

        <record id="group_jacon_office_editor" model="res.groups">
            <field name="name">Editor</field>
            <field name="privilege_id" ref="privilege_jacon_office"/>
            <field name="implied_ids" eval="[(4, ref('group_jacon_office_viewer'))]"/>
            <field name="comment">Viewer, and can create documents, edit them (name, category, author, content), archive them, restore a Rev, and create and edit templates. Editing also needs write access to the record the document belongs to.</field>
        </record>

        <record id="group_jacon_office_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_jacon_office"/>
            <field name="implied_ids" eval="[(4, ref('group_jacon_office_editor'))]"/>
            <field name="comment">Editor, and can delete documents, Revs and templates, and manage the categories and the settings.</field>
        </record>

        <!-- Every internal user can look at documents (what they see is limited by the record the
             document belongs to). Creating and editing is given on purpose: Editor. -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('jacon_office.group_jacon_office_viewer')), (3, ref('jacon_office.group_jacon_office_editor'))]"/>
        </record>

        <!-- Settings administrators manage Office Documents too. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('jacon_office.group_jacon_office_manager'))]"/>
        </record>

    </data>
</odoo>
