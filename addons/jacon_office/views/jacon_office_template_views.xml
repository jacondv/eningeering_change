<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_jacon_office_template_list" model="ir.ui.view">
        <field name="name">jacon.office.template.list</field>
        <field name="model">jacon.office.template</field>
        <field name="arch" type="xml">
            <list string="Templates">
                <field name="sequence" widget="handle" groups="jacon_office.group_jacon_office_manager"/>
                <field name="name"/>
                <field name="kind" widget="badge"/>
                <field name="category_id"/>
                <field name="description" optional="show"/>
                <field name="file_size_text"/>
                <button name="action_open_editor" type="object" icon="fa-pencil" title="Edit in ONLYOFFICE"
                        groups="jacon_office.group_jacon_office_manager"/>
                <button name="action_download" type="object" icon="fa-download" title="Download"/>
            </list>
        </field>
    </record>

    <record id="view_jacon_office_template_form" model="ir.ui.view">
        <field name="name">jacon.office.template.form</field>
        <field name="model">jacon.office.template</field>
        <field name="arch" type="xml">
            <form string="Template">
                <header>
                    <button name="action_open_editor" type="object" string="Edit" class="btn-primary"
                            groups="jacon_office.group_jacon_office_manager" invisible="not attachment_id"/>
                    <button name="action_download" type="object" string="Download" invisible="not attachment_id"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="can_change" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template name" readonly="not can_change"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="upload" filename="upload_filename"
                                   string="File (replace it with another of the same type)"
                                   readonly="not can_change"/>
                            <field name="upload_filename" invisible="1"/>
                            <field name="kind" invisible="not kind"/>
                            <field name="category_id" options="{'no_create': true}" readonly="not can_change"/>
                        </group>
                        <group>
                            <field name="file_size_text" invisible="not attachment_id"/>
                            <field name="sequence" readonly="not can_change"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this template is for..." readonly="not can_change"/>
                    <group string="Placeholders">
                        <field name="placeholder_guide" nolabel="1" colspan="2"/>
                        <field name="placeholder_report" string="In this file" colspan="2" readonly="1"
                               invisible="not placeholder_report"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_jacon_office_template_search" model="ir.ui.view">
        <field name="name">jacon.office.template.search</field>
        <field name="model">jacon.office.template</field>
        <field name="arch" type="xml">
            <search string="Templates">
                <field name="name"/>
                <field name="category_id"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_jacon_office_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">jacon.office.template</field>
        <field name="path">office-templates</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_jacon_office_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the company's own files as templates</p>
            <p>New documents can start from a template: its theme, fonts, logo and layout come with it.</p>
        </field>
    </record>

</odoo>
