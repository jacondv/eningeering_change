<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Makes the PDFs of documents whose file just changed. It is also triggered right after
             each save; the hourly run is the safety net. -->
        <record id="ir_cron_convert_pdf" model="ir.cron">
            <field name="name">Office Documents: make PDFs</field>
            <field name="model_id" ref="model_jacon_office_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_convert_pending_pdfs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
