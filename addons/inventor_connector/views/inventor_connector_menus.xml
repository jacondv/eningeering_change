<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- BOM Manager only has ACL rights on inventor.bom itself (see
         ir.model.access.csv) - BOM Type Registry and Settings stay
         base.group_system-only, so the root menu must be reachable by
         either group for BOM Manager to ever see "Inventor BOMs" under it. -->
    <menuitem id="menu_inventor_connector_root" name="Inventor Connector"
              groups="base.group_system,inventor_connector.group_inventor_bom_manager" sequence="90"/>

    <menuitem id="menu_inventor_bom" name="Inventor BOMs"
              parent="menu_inventor_connector_root" action="action_inventor_bom" sequence="10"
              groups="base.group_system,inventor_connector.group_inventor_bom_manager"/>

    <menuitem id="menu_inventor_bom_type" name="BOM Type Registry"
              parent="menu_inventor_connector_root" action="action_inventor_bom_type" sequence="20"
              groups="base.group_system"/>

    <menuitem id="menu_inventor_connector_settings" name="Settings"
              parent="menu_inventor_connector_root" action="action_inventor_connector_settings" sequence="30"
              groups="base.group_system"/>

</odoo>
