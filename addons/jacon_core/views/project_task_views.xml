<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_task_form2_task_type" model="ir.ui.view">
        <field name="name">project.task.form.task.type</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="task_type"/>
            </field>
        </field>
    </record>

    <!-- ================= LIST VIEW ================= -->
    <record id="view_task_tree2_task_type" model="ir.ui.view">
        <field name="name">project.task.list.task.type</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="task_type" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- ================= SEARCH VIEW ================= -->
    <record id="view_task_search_form_task_type" model="ir.ui.view">
        <field name="name">project.task.search.task.type</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <field name="task_properties" position="after">
                <field name="task_type"/>
            </field>
            <filter name="stage" position="after">
                <filter string="Task Type" name="group_task_type" context="{'group_by': 'task_type'}"/>
            </filter>
        </field>
    </record>

</odoo>
