<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_task_form2_task_type" model="ir.ui.view">
        <field name="name">project.task.form.task.type</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Non-blocking heads-up when assigning this task would push
                 an engineer over daily capacity somewhere between its
                 Start Date and Deadline - see
                 project_task._compute_overload_warning. Odoo's stock form
                 reserves this exact spot for inherited warnings. -->
            <xpath expr="//t[@name='warning_section']" position="after">
                <div class="alert alert-warning mb-0" role="alert" invisible="not overload_warning">
                    <strong><i class="fa fa-exclamation-triangle"/> Cảnh báo quá tải lịch làm việc</strong>
                    <field name="overload_warning" nolabel="1" readonly="1"/>
                    <button name="action_view_overload_conflicts" type="object"
                            string="Xem &amp; xử lý xung đột" class="btn btn-sm btn-outline-warning mt-1"
                            invisible="not id"/>
                </div>
            </xpath>

            <!-- Explicit Start Date (default: creation date, editable) -
                 the overload calculation spreads remaining hours across
                 working days from here to Deadline, a fixed window
                 instead of always "today". -->
            <xpath expr="//label[@for='date_deadline']" position="before">
                <label for="date_start"/>
                <field name="date_start"/>
            </xpath>
            <field name="tag_ids" position="after">
                <field name="task_type"/>
            </field>
            <xpath expr="//page[@name='sub_tasks_page']//list/field[@name='project_id']" position="before">
                <field name="task_type" optional="hide"/>
            </xpath>
            <page name="description_page" position="after">
                <page string="Evidence" name="evidence">
                    <field name="evidence_ids">
                        <list editable="bottom">
                            <button name="action_open_attachment" type="object"
                                    icon="fa-external-link" title="Open File"
                                    invisible="not attachment"/>
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" column_invisible="1"/>
                            <field name="description"/>
                            <field name="upload_uid" readonly="1"/>
                            <field name="upload_date" readonly="1"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <!-- ================= LIST VIEW ================= -->
    <record id="view_task_tree2_task_type" model="ir.ui.view">
        <field name="name">project.task.list.task.type</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="task_type" optional="hide"/>
            </field>
            <!-- Show the actual date ("5 Aug, 2026") instead of the
                 default relative wording ("Tomorrow", "6 days ago") - the
                 red-when-overdue coloring came from the remaining_days
                 widget we just replaced, so it has to be re-declared here. -->
            <field name="date_deadline" position="attributes">
                <attribute name="widget">day_month_date</attribute>
                <attribute name="decoration-danger">date_deadline and date_deadline &lt; current_date and state not in ['1_done', '1_canceled']</attribute>
            </field>
            <!-- Left-align numeric columns + darker zebra striping (see
                 static/src/list/left_align_number_list_view.js) -->
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">jacon_core_task_list</attribute>
            </xpath>
        </field>
    </record>

    <!-- ================= KANBAN VIEW ================= -->
    <record id="view_task_kanban_deadline_date" model="ir.ui.view">
        <field name="name">project.task.kanban.deadline.date</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <!-- Show the actual date ("5 Aug, 2026") instead of the
                 default relative wording ("Tomorrow", "In 26 days") -->
            <field name="date_deadline" position="attributes">
                <attribute name="widget">day_month_date</attribute>
            </field>
        </field>
    </record>

    <!-- ================= SEARCH VIEW ================= -->
    <record id="view_task_search_form_task_type" model="ir.ui.view">
        <field name="name">project.task.search.task.type</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <field name="task_properties" position="after">
                <field name="task_type"/>
            </field>
            <filter name="stage" position="after">
                <filter string="Task Type" name="group_task_type" context="{'group_by': 'task_type'}"/>
            </filter>
        </field>
    </record>

</odoo>
