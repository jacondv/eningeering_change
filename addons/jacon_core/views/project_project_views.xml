<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- last_update_status already shows read-only on this form (core
         Odoo, status_with_color widget) - unlocked for editing here, but
         only once the project itself is unlocked (is_unlocked - see
         edit_project_inherit_equipment_model) AND for whoever can actually
         change it per ProjectProject.write (Engineering Head/Admin -
         can_change_last_update_status mirrors that check). Setting it to
         On-Hold/Cancelled/EOL (ARCHIVAL_UPDATE_STATUSES in
         models/project_project.py) also archives the project - one atomic
         write, see write() itself. -->
    <record id="edit_project_inherit_last_update_status" model="ir.ui.view">
        <field name="name">project.project.form.inherit.last.update.status</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='last_update_status'][@widget='status_with_color']" position="attributes">
                <attribute name="readonly">not is_unlocked or not can_change_last_update_status</attribute>
            </xpath>
            <xpath expr="//field[@name='last_update_status'][@widget='status_with_color']" position="after">
                <field name="can_change_last_update_status" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Core's stage_id statusbar folds any stage flagged fold=True (used
         for collapsing Kanban columns) into a "..." dropdown regardless of
         how much room the row has - most of Jacon's stages are flagged
         that way (Testing, Sales, Closed, In Progress, To Do, Cancelled),
         which is why only 3 stages ever showed inline. Dropping
         fold_field here shows every stage inline instead, same as
         engineering_change's own state statusbar (a Selection field,
         which has no fold concept at all) - Kanban's own column folding
         is untouched since it reads `fold` independently of this widget
         option. -->
    <record id="edit_project_stage_statusbar_no_fold" model="ir.ui.view">
        <field name="name">project.project.form.stage.statusbar.no.fold</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="stage_id" position="attributes">
                <attribute name="options">{'clickable': '1'}</attribute>
            </field>
        </field>
    </record>

    <!-- Move Tags from the left header group (Name of Tasks/Customer/
         Company) to the bottom of the right one, after Project Manager/
         Planned Date/Allocated Time - can't relocate an element in place
         via inheritance, so this removes it from its original spot and
         adds an equivalent field (same widget/options as core) in the new
         one. Depends on hr_timesheet's own inherit of this same view
         (adds allocated_hours) having already applied - see priority. -->
    <record id="edit_project_move_tags_to_manager_group" model="ir.ui.view">
        <field name="name">project.project.form.move.tags.to.manager.group</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="tag_ids" position="replace"/>
            <field name="allocated_hours" position="after">
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </field>
        </field>
    </record>

    <record id="edit_project_inherit_equipment_model" model="ir.ui.view">
        <field name="name">project.project.form.inherit.equipment.model</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="customer_ref" placeholder="e.g. their own PO/product code"/>
            </field>
            <field name="partner_id" position="before">
                <field name="model_id" options="{'no_create': True}"/>
                <field name="machine_serial" placeholder="e.g. S30-2106-163"/>
                <field name="engine_serial" placeholder="e.g. 12190634"/>
                <field name="vin_tin" placeholder="e.g. 6U9VSS00000244099"/>
            </field>
            <xpath expr="//group//field[@name='label_tasks']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="is_unlocked" widget="project_edit_lock_button" nolabel="1"/>
                <button name="action_delete_with_password" string="Delete" type="object"
                        invisible="not id"/>
            </xpath>
        </field>
    </record>

    <!-- Customer is normally only shown when the project has "Billable"
         enabled (Sales integration, see sale_project's own inherit of this
         same field) - other jacon_core fields (Project Events, Equipment
         Serials) don't depend on Billable, so drop that condition here
         (still hidden for templates). High priority so this is combined
         last and reliably wins over other addons' own attribute overrides
         on the same field, regardless of view/module install order. -->
    <record id="edit_project_partner_id_always_visible" model="ir.ui.view">
        <field name="name">project.project.form.partner.always.visible</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="invisible">is_template</attribute>
            </field>
        </field>
    </record>

    <record id="edit_project_inherit_project_events" model="ir.ui.view">
        <field name="name">project.project.form.inherit.project.events</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page name="project_events" string="Project Events">
                    <group>
                        <group>
                            <field name="po_number" placeholder="e.g. PO132511"/>
                            <field name="po_received_date" widget="date_or_na" options="{'numeric': True}"/>
                            <field name="iof_release_date" widget="date_or_na" options="{'numeric': True}"/>
                            <field name="bom_release_date" widget="date_or_na" options="{'numeric': True}"/>
                        </group>
                        <group>
                            <field name="drawing_release_date" widget="date_or_na" options="{'numeric': True}"/>
                            <field name="qc_checksheet_date" widget="date_or_na" options="{'numeric': True}"/>
                            <field name="photo_taken_date" widget="date_or_na" options="{'numeric': True}"/>
                            <field name="dispatch_date" widget="date_or_na" options="{'numeric': True}"/>
                        </group>
                    </group>
                    <field name="project_events_note" placeholder="Notes..."/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_project_inherit_project_events" model="ir.ui.view">
        <field name="name">project.project.list.inherit.project.events</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <!-- Left-align numeric columns + darker zebra striping (see
                 static/src/list/left_align_number_list_view.js) -->
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">jacon_core_project_list</attribute>
            </xpath>
            <!-- "Tasks" button: drop it from its original spot (after Stage)
                 and re-add it before Name, renamed from "View Tasks". -->
            <xpath expr="//button[@name='action_view_tasks']" position="replace"/>
            <field name="name" position="before">
                <button string="Tasks" name="action_view_tasks" type="object"/>
            </field>
            <field name="stage_id" position="after">
                <field name="customer_ref" optional="hide"/>
                <field name="po_number" optional="hide"/>
                <field name="po_received_date" widget="date_or_na" options="{'numeric': True}" optional="hide"/>
                <field name="iof_release_date" widget="date_or_na" options="{'numeric': True}" optional="hide"/>
                <field name="bom_release_date" widget="date_or_na" options="{'numeric': True}" optional="hide"/>
                <field name="drawing_release_date" widget="date_or_na" options="{'numeric': True}" optional="hide"/>
                <field name="qc_checksheet_date" widget="date_or_na" options="{'numeric': True}" optional="hide"/>
                <field name="photo_taken_date" widget="date_or_na" options="{'numeric': True}" optional="hide"/>
                <field name="dispatch_date" widget="date_or_na" options="{'numeric': True}" optional="hide"/>
                <field name="project_events_note" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="project_project_view_form_simplified_inherit_equipment_model" model="ir.ui.view">
        <field name="name">project.project.view.form.simplified.inherit.equipment.model</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="arch" type="xml">
            <div name="alias_def" position="before">
                <group>
                    <field name="model_id" options="{'no_create': True}"/>
                </group>
            </div>
        </field>
    </record>

</odoo>
