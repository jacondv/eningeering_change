<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Flags project's own default "Cancelled" stage as archival too,
             alongside the two new ones below - see
             ProjectProjectStage.is_archival_stage for what that means.
             A <function> call, not a <record> update: that xmlid's
             ir.model.data row already carries noupdate=1 from the `project`
             module itself (default/demo config data usually ships that
             way), which would silently skip a <record> write here
             regardless of this file's own noupdate setting - <function>
             isn't subject to that flag at all, it just always runs. -->
        <function model="project.project.stage" name="write"
                   eval="[[ref('project.project_project_stage_3')], {'is_archival_stage': True}]"/>

        <record id="project_project_stage_on_hold" model="project.project.stage">
            <field name="name">On-Hold</field>
            <field name="sequence">26</field>
            <field name="is_archival_stage">True</field>
        </record>

        <record id="project_project_stage_eol" model="project.project.stage">
            <field name="name">EOL</field>
            <field name="sequence">27</field>
            <field name="is_archival_stage">True</field>
        </record>

    </data>
</odoo>
