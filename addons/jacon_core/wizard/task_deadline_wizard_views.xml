<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_deadline_wizard_form" model="ir.ui.view">
        <field name="name">jacon.task.deadline.wizard.form</field>
        <field name="model">jacon.task.deadline.wizard</field>
        <field name="arch" type="xml">
            <form string="Resolve Schedule Conflicts">
                <p class="text-muted">
                    The tasks below are contributing to a schedule overload.
                    "New Deadline" is pre-filled with the nearest date that has room - click to review/adjust if needed,
                    nothing is applied to the real tasks until you click "Save".
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="project_id" readonly="1"/>
                        <field name="task_id" readonly="1"/>
                        <field name="user_ids" widget="many2many_tags" readonly="1"/>
                        <field name="remaining_hours" readonly="1"/>
                        <field name="current_deadline" readonly="1"/>
                        <field name="new_deadline"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Save" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
