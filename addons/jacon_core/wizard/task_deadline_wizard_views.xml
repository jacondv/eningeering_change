<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_deadline_wizard_form" model="ir.ui.view">
        <field name="name">jacon.task.deadline.wizard.form</field>
        <field name="model">jacon.task.deadline.wizard</field>
        <field name="arch" type="xml">
            <form string="Xử lý xung đột lịch">
                <p class="text-muted">
                    Các task dưới đây đang góp phần gây quá tải lịch làm việc.
                    "Gợi ý ngày" chỉ điền thử ở đây - bấm "Lưu" mới thực sự áp dụng vào task.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="project_id" readonly="1"/>
                        <field name="task_id" readonly="1"/>
                        <field name="user_ids" widget="many2many_tags" readonly="1"/>
                        <field name="remaining_hours" readonly="1"/>
                        <field name="current_deadline" readonly="1"/>
                        <field name="new_deadline"/>
                        <widget name="suggest_deadline_button"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Lưu" class="btn-primary"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
