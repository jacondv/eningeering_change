<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_propose_deadline_wizard_form" model="ir.ui.view">
        <field name="name">jacon.task.propose.deadline.wizard.form</field>
        <field name="model">jacon.task.propose.deadline.wizard</field>
        <field name="arch" type="xml">
            <form string="Propose New Deadline">
                <group>
                    <field name="current_deadline" readonly="1"/>
                    <field name="new_deadline"/>
                    <field name="reason" placeholder="Why does this task need a new deadline?"/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
