<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_propose_deadline_wizard_form" model="ir.ui.view">
        <field name="name">jacon.task.propose.schedule.wizard.form</field>
        <field name="model">jacon.task.propose.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Propose Schedule Change">
                <group>
                    <group string="Current">
                        <field name="current_date_start" readonly="1"/>
                        <field name="current_date_deadline" readonly="1"/>
                        <field name="current_allocated_hours" readonly="1"/>
                    </group>
                    <group string="Proposed">
                        <field name="new_date_start"/>
                        <field name="new_date_deadline"/>
                        <field name="new_allocated_hours"/>
                    </group>
                </group>
                <field name="reason" placeholder="Why does this task need a different schedule?"/>
                <footer>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
