<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jacon_delete_password_wizard_form" model="ir.ui.view">
        <field name="name">jacon.delete.password.wizard.form</field>
        <field name="model">jacon.delete.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Deletion">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="redirect_action_xmlid" invisible="1"/>
                <p>This will permanently delete this record. This cannot be undone.</p>
                <group>
                    <field name="password" password="True" placeholder="Enter your password to confirm"/>
                </group>
                <footer>
                    <button name="action_confirm_delete" type="object" string="Delete Permanently" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
