<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="jacon_core.TaskTitleTreeField">
        <div class="d-flex align-items-baseline" t-attf-style="padding-left: #{props.record.data.hierarchy_depth * 20}px;">
            <div class="flex-grow-1">
                <t t-call="jacon_core.TaskTitleAutocompleteField"/>
            </div>
            <span class="text-muted ms-2 text-nowrap" t-if="props.record.data.subtask_count">
                (<t t-out="props.record.data.closed_subtask_count"/>/<t t-out="props.record.data.subtask_count"/> sub-tasks)
            </span>
        </div>
    </t>

</templates>
