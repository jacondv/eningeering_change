<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="jacon_core.DateOrNaField" t-inherit="web.DateTimeField" t-inherit-mode="primary">
        <xpath expr="//span[@t-esc='getFormattedValue(0)']" position="attributes">
            <attribute name="t-if">true</attribute>
            <attribute name="t-esc">getFormattedValue(0) || 'N/A'</attribute>
        </xpath>
    </t>

</templates>
