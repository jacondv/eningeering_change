<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The settings menu at the end of a list header: for lists with the class "o_jacon_column_order",
         one line per column - check box (shown / hidden), title, up / down - see column_order_list_view.js. -->
    <t t-name="jacon_core.ListRenderer.ColumnOrder" t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_optional_columns_dropdown')]//t[@t-set-slot='content']" position="inside">
            <t t-if="jaconColumnOrderEnabled">
                <div class="px-3 pb-1 small text-muted">Columns</div>
                <div t-foreach="jaconMenuColumns" t-as="column" t-key="column.id"
                     class="o_jacon_column_order_row d-flex align-items-center px-3">
                    <CheckBox value="jaconColumnShown(column)" disabled="!column.optional"
                              className="'flex-grow-1 text-truncate me-3 mb-0'"
                              onChange="() => this.toggleOptionalField(column.name)">
                        <span class="text-truncate" t-esc="jaconColumnLabel(column)"/>
                    </CheckBox>
                    <button type="button" class="btn btn-sm btn-link p-0 px-1" title="Move earlier"
                            t-att-disabled="!jaconCanMove(column, -1)" t-on-click.stop="() => this.jaconMoveColumn(column, -1)">
                        <i class="fa fa-arrow-up"/>
                    </button>
                    <button type="button" class="btn btn-sm btn-link p-0 px-1" title="Move later"
                            t-att-disabled="!jaconCanMove(column, 1)" t-on-click.stop="() => this.jaconMoveColumn(column, 1)">
                        <i class="fa fa-arrow-down"/>
                    </button>
                </div>
                <div role="separator" class="dropdown-divider"/>
                <DropdownItem closingMode="'none'" onSelected="() => this.jaconResetColumnOrder()">
                    <i class="fa fa-undo me-1"/>Reset order
                </DropdownItem>
            </t>
        </xpath>
    </t>

</templates>
