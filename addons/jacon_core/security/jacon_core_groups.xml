<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_jacon_core" model="ir.module.category">
            <field name="name">Jacon - Core</field>
            <field name="sequence">29</field>
        </record>

        <record id="privilege_line_manager" model="res.groups.privilege">
            <field name="name">Line Manager</field>
            <field name="category_id" ref="module_category_jacon_core"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_head_office" model="res.groups.privilege">
            <field name="name">Head Office</field>
            <field name="category_id" ref="module_category_jacon_core"/>
            <field name="sequence">20</field>
        </record>

        <!-- Base organizational-role groups, meant to be reused by any module
             that depends on jacon_core - not tied to one business domain's
             own approval workflow. engineering_change's own "Line Manager
             Approve"/"Engineering Head Approve" privileges (still defined
             there, and still their own separately-toggleable checkboxes in
             Settings - EC depends on jacon_core so it can freely reference
             these) imply these two groups via their own implied_ids, so
             granting an EC approval role also flags that person as
             "Line Manager"/"Head Office" here. That lets jacon_core-level
             permissions (e.g. who may change a Project's Stage - see
             models/project_project.py) check the role directly, without
             ever needing to depend on engineering_change. -->
        <record id="group_line_manager" model="res.groups">
            <field name="name">Line Manager</field>
            <field name="privilege_id" ref="privilege_line_manager"/>
            <field name="comment">Organizational Line Manager role, shared across modules - not tied to one specific approval workflow.</field>
        </record>

        <record id="group_head_office" model="res.groups">
            <field name="name">Head Office</field>
            <field name="privilege_id" ref="privilege_head_office"/>
            <field name="implied_ids" eval="[(4, ref('group_line_manager'))]"/>
            <field name="comment">Organizational Head Office role, shared across modules. Includes the Line Manager role.</field>
        </record>

    </data>
</odoo>
